---
// Экран результата на /dyakuyemo (ARCHITECTURE.md 4.4). Скрипт подставляет имя и способ связи из sessionStorage:
// «Дякуємо, {ім’я}. Надішлемо розрахунок у {Viber / Telegram} у робочий час»,
// для звонка — «Зателефонуємо у робочий час» (без минут — режим запуска 2026-10-21). Без данных — общий текст со звонком.
// Цена (экран А) — только при reason 'ok' и флаге facts.flags.quizResultVariant = 'A'; по умолчанию Б (без цены).
// При флаге Б разметки экрана А на странице нет вовсе — ни с JS, ни без него (правка 2026-10-21).
// Подарок (3D) — только когда владелец подтвердит.
import { facts } from '../../content/facts';
import { has } from '../../lib/facts';

const { promises } = facts;
const variantA = facts.flags.quizResultVariant === 'A';
---

<div class="quiz-result" data-quiz-result data-shown="generic">
  {
    variantA && (
      <div data-result="A" hidden>
        <p class="quiz-result__label">Орієнтовна вартість</p>
        <p class="quiz-result__price">
          від <span data-price-from /> до <span data-price-to />
        </p>
        <p>Точна ціна — після безкоштовного заміру.</p>
      </div>
    )
  }

  <p class="quiz-result__lead" data-thanks>
    Дякуємо<span data-thanks-name></span>.{' '}<span data-thanks-action>Зателефонуємо</span>{' '}у робочий час.
  </p>

  <div data-result="B" hidden>
    <p class="quiz-result__no-length" data-no-length hidden>Порахуємо точно після заміру — це безкоштовно.</p>
    {has(promises.gift3dText) && <p class="quiz-result__gift">{promises.gift3dText}</p>}
  </div>
</div>

<style>
  .quiz-result {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .quiz-result > div {
    display: grid;
    gap: 0.75rem;
  }
  .quiz-result > div[hidden],
  .quiz-result [hidden] {
    display: none;
  }
  .quiz-result__label {
    color: var(--color-ink-muted);
  }
  .quiz-result__price {
    font-family: var(--font-mono);
    font-size: var(--text-price);
    line-height: var(--text-price--line-height);
    font-variant-numeric: tabular-nums;
  }
  .quiz-result__lead {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .quiz-result__gift {
    font-weight: 600;
  }
  @media (min-width: 48rem) {
    .quiz-result {
      padding: 2rem;
    }
  }
</style>

<script>
  import { CHANNEL_LABEL, takeThanks, type ThanksData } from '../../lib/lead/result-store';
  import { formatUAH } from '../../lib/facts';

  const box = document.querySelector<HTMLElement>('[data-quiz-result]');
  if (box) {
    const data: ThanksData | null = takeThanks();
    const hasA = Boolean(box.querySelector('[data-result="A"]'));
    if (data) {
      if (data.name) box.querySelector('[data-thanks-name]')!.textContent = `, ${data.name}`;
      box.querySelector('[data-thanks-action]')!.textContent =
        data.method === 'call' ? 'Зателефонуємо' : `Надішлемо розрахунок у ${CHANNEL_LABEL[data.method]}`;
      box.dataset.method = data.method;
    }
    const result = data?.result;
    if (result) {
      const show = hasA && result.variant === 'A' && result.reason === 'ok' && result.price ? 'A' : 'B';
      box.querySelectorAll<HTMLElement>('[data-result]').forEach((el) => (el.hidden = el.dataset.result !== show));
      if (show === 'A' && result.price) {
        box.querySelector('[data-price-from]')!.textContent = formatUAH(result.price.from);
        box.querySelector('[data-price-to]')!.textContent = formatUAH(result.price.to);
      }
      const noLength = box.querySelector<HTMLElement>('[data-no-length]');
      if (noLength) noLength.hidden = result.reason !== 'no-length';
      box.dataset.shown = show;
    }
  }
</script>
