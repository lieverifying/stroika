---
// Схема варианта квиза, вид сверху: форма кухни (шаг 2 ветки кухни) и тип шафы (купе, розпашна, гардеробна).
// Графитовые линии, без жёлтого. Декор — aria-hidden. Стены — тонкая линия, корпуса — заливка с обводкой.
// Купе — две двери внахлёст со стрелкой сдвига; розпашна — створки с дугой открывания; гардеробна — П-образные полки.
import type { KitchenShape, WardrobeType } from '../../lib/quiz/types';

interface Props {
  shape: KitchenShape | WardrobeType;
}
const { shape } = Astro.props;
---

<svg class="shape-icon" viewBox="0 0 64 48" aria-hidden="true">
  <path class="shape-icon__wall" d="M4 4h56v40" />
  <path class="shape-icon__wall" d="M4 4v40" />
  {shape === 'pryama' && <rect x="8" y="8" width="48" height="9" />}
  {shape === 'kutova' && <path d="M8 8h48v9H17v23H8z" />}
  {shape === 'p-podibna' && <path d="M8 8h48v32h-9V17H17v23H8z" />}
  {
    shape === 'ostriv' && (
      <>
        <rect x="8" y="8" width="48" height="9" />
        <rect x="20" y="27" width="24" height="10" />
      </>
    )
  }
  {
    shape === 'kupe' && (
      <>
        <rect x="8" y="8" width="48" height="10" />
        <path class="shape-icon__door" d="M8 21h26M30 24h26" />
        <path class="shape-icon__move" d="M22 33h20M38 30l4 3-4 3M26 30l-4 3 4 3" />
      </>
    )
  }
  {
    shape === 'rozpashna' && (
      <>
        <rect x="8" y="8" width="48" height="10" />
        <path class="shape-icon__door" d="M8 18l10 16M56 18l-10 16" />
        <path class="shape-icon__arc" d="M32 18a14 14 0 0 1-14 16M32 18a14 14 0 0 0 14 16" />
      </>
    )
  }
  {shape === 'harderobna' && <path d="M8 8h48v32h-7V15H15v25H8z" />}
</svg>

<style>
  .shape-icon {
    width: 4rem;
    height: 3rem;
    fill: var(--color-placeholder);
    stroke: var(--color-graphite);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .shape-icon__door {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .shape-icon__move,
  .shape-icon__arc {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 1.25;
    stroke-linecap: round;
  }
  .shape-icon__arc {
    stroke-dasharray: 2 2;
  }
  .shape-icon__wall {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 1;
  }
</style>
