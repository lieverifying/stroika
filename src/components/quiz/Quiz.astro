---
// Квиз-калькулятор (ТЗ, блок 5; ARCHITECTURE.md 4): все шаги в разметке, виден один.
// Логика (переходы, «Назад», сохранение) — src/scripts/quiz.ts, грузится, когда квиз близко к экрану.
// Без JS виден шаг 1 и ссылка на форму замера.
import QuizProgress from './QuizProgress.astro';
import QuizStep from './QuizStep.astro';
import QuizContact from './QuizContact.astro';
import { STEPS } from '../../lib/quiz/config';
import type { Goal } from '../../lib/quiz/types';

interface Props {
  /** Заранее выбранная ветка на шаге 1 (посадочная /kukhni или /mebli) */
  preset?: Goal;
}
const { preset } = Astro.props;
---

<div class="quiz" data-quiz data-preset={preset}>
  <QuizProgress />
  <button type="button" class="quiz__resume" data-quiz-resume hidden>Продовжити, де зупинились</button>
  {
    Object.values(STEPS).map((step) => (
      <QuizStep step={step} hidden={step.id !== 'goal'}>
        {step.kind === 'contact' && <QuizContact />}
      </QuizStep>
    ))
  }
  <div class="quiz__nav">
    <button type="button" class="quiz__back" data-quiz-back hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
      Назад
    </button>
    <button type="button" class="quiz__restart" data-quiz-restart hidden>Почати заново</button>
  </div>
  <noscript>
    <p class="quiz__fallback">Квіз працює з увімкненим JavaScript. Або <a href="#zamir">залиште заявку на безкоштовний замір</a>.</p>
  </noscript>
</div>

<script>
  // Островок квиза грузится, когда квиз подъезжает к экрану (или сразу, если пришли по #kvyz)
  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) {
    const load = () => import('../../scripts/quiz').then((m) => m.initQuiz(root));
    if (location.hash === '#kvyz' || !('IntersectionObserver' in window)) load();
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: '400px 0px' },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .quiz {
    display: grid;
    gap: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .quiz__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .quiz__nav:has(.quiz__back[hidden]):has(.quiz__restart[hidden]) {
    display: none;
  }
  .quiz__resume {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    padding-inline: 1.25rem;
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-md);
    background: var(--color-plaster);
    color: var(--color-graphite);
    font-size: var(--text-button);
    font-weight: 600;
    cursor: pointer;
  }
  .quiz__resume[hidden] {
    display: none;
  }
  .quiz__restart {
    min-height: var(--control-h);
    padding-inline: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .quiz__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--control-h);
    padding-inline: 1rem 1.25rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-graphite);
    font-size: var(--text-button);
    font-weight: 600;
    cursor: pointer;
  }
  .quiz__back svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .quiz__fallback a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 48rem) {
    .quiz {
      padding: 2rem;
    }
  }
</style>
