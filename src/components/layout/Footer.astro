---
// Блок 14 — футер (ТЗ): контакты, график, соцсети, ссылка на политику. Реквизитов ФОП нет (решение владельца, 2026-10-21).
// Режим запуска: почта, график и адрес — только когда есть факт и включён флаг. Instagram и TikTok — SocialLinks.
// Тёмный фон; все ссылки — зоны нажатия ≥ 48 px. Нижнюю панель телефона футер не прячет: body уже с отступом под неё.
// Телефон (< 768 px, правка 2026-10-22) — компактный подвал: логотип, одна строка иконок (телефон, Viber, Telegram,
// Instagram, TikTok), «Черкаси та область», политика; без крупных кнопок и слогана. С 768 px — полный подвал.
import Button from '../ui/Button.astro';
import Fact from '../ui/Fact.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { facts } from '../../content/facts';
import { contactLinks } from '../../lib/contacts';
import { has } from '../../lib/facts';
import { SLOGAN } from '../../content/brand';

const { contacts: c, brand } = facts;
const year = new Date().getFullYear();
// Строка иконок компактного подвала; Instagram и TikTok — только когда включён флаг и есть ссылка
const icons = [
  { href: contactLinks.tel, icon: 'phone' as const, label: `Подзвонити ${c.phoneDisplay}` },
  { href: contactLinks.viber, icon: 'viber' as const, label: 'Viber' },
  { href: contactLinks.telegram, icon: 'telegram' as const, label: 'Telegram' },
  ...(facts.flags.instagram && contactLinks.instagram ? [{ href: contactLinks.instagram, icon: 'instagram' as const, label: 'Instagram', ext: true }] : []),
  ...(facts.flags.instagram && contactLinks.tiktok ? [{ href: contactLinks.tiktok, icon: 'tiktok' as const, label: 'TikTok', ext: true }] : []),
];
---

<footer data-block="14" class="site-footer on-dark">
  <div class="container-site site-footer__compact" data-footer-compact>
    <img src="/brand/logo-dark.svg" alt="Вимір" width="148" height="32" class="site-footer__logo" />
    <ul class="site-footer__icons">
      {
        icons.map((i) => (
          <li>
            <a href={i.href} class="site-footer__icon" aria-label={i.label} target={i.ext ? '_blank' : undefined} rel={i.ext ? 'noopener' : undefined}>
              <Icon name={i.icon} size={22} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="site-footer__muted">{facts.serviceArea.text}</p>
    <a href="/polityka" class="site-footer__link site-footer__muted">Політика конфіденційності</a>
  </div>

  <div class="container-site site-footer__grid" data-footer-full>
    <div class="site-footer__brand">
      <img src="/brand/logo-dark.svg" alt="Вимір" width="148" height="32" class="site-footer__logo" />
      <p class="site-footer__slogan">{SLOGAN}</p>
      <p class="site-footer__muted">{brand.descriptor}</p>
      <a href="/yak-my-stvoriuiemo" class="site-footer__link">Як ми створюємо</a>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__title">Контакти</h2>
      <ul class="site-footer__list">
        <li>
          <a href={contactLinks.tel} class="site-footer__link site-footer__phone">
            <Icon name="phone" size={20} />
            <Fact value={c.phoneDisplay} />
          </a>
        </li>
        {
          has(c.emailPublic) && (
            <li>
              <a href={contactLinks.email} class="site-footer__link">{c.emailPublic}</a>
            </li>
          )
        }
        <li class="site-footer__muted">{facts.serviceArea.text}</li>
        {facts.flags.schedule && has(c.scheduleText) && <li class="site-footer__muted">{c.scheduleText}</li>}
        {facts.flags.address && has(c.address) && <li class="site-footer__muted">{c.address}</li>}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__title">Месенджери та соцмережі</h2>
      <p class="site-footer__muted">@{c.instagramHandle} в Instagram і TikTok</p>
      <div class="site-footer__social">
        <Button href={contactLinks.viber} variant="outline" icon="viber">Viber</Button>
        <Button href={contactLinks.telegram} variant="outline" icon="telegram">Telegram</Button>
        <SocialLinks />
      </div>
    </div>

  </div>
  <div class="container-site site-footer__bottom" data-footer-full>
    <p class="site-footer__muted">© {year} {brand.name}</p>
    <a href="/polityka" class="site-footer__link site-footer__muted">Політика конфіденційності</a>
  </div>
</footer>

<style>
  .site-footer__slogan {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
  }
  .site-footer {
    /* Линия сверху: тёмный финал страницы и подвал не сливаются в один блок */
    border-top: 1px solid rgb(241 241 238 / 0.12);
    background: var(--color-graphite);
    color: var(--color-plaster);
  }
  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem 2.5rem;
  }
  .site-footer__logo {
    height: 2rem;
    width: auto;
  }
  .site-footer__brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .site-footer__col {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
  }
  .site-footer__title {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted-dark);
  }
  .site-footer__list {
    display: grid;
    gap: 0.25rem;
  }
  .site-footer__list > li {
    min-width: 0;
  }
  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--control-h);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .site-footer__phone {
    font-size: var(--text-lead);
    font-weight: 600;
    text-decoration: none;
  }
  .site-footer__muted {
    color: var(--color-ink-muted-dark);
  }
  .site-footer__list > .site-footer__muted,
  .site-footer__list.site-footer__muted > li:not(:has(a)) {
    padding-block: 0.5rem;
  }
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-graphite-2);
    font-size: var(--text-small);
  }
  /* Компактный подвал телефона */
  .site-footer__compact {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: 2.5rem 1.5rem;
  }
  .site-footer__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .site-footer__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-ink-muted-dark);
    border-radius: var(--radius-full);
    color: var(--color-plaster);
  }
  @media (max-width: 47.99rem) {
    [data-footer-full] {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .site-footer__compact {
      display: none;
    }
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1.2fr 1.2fr;
      gap: 2rem;
      padding-block: 4.5rem 3rem;
    }
  }
</style>
