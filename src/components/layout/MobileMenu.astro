---
// Мобильное меню (< 1024 px). Открывается бургером в Header; скрипт — там же.
import Button from '../ui/Button.astro';
import Fact from '../ui/Fact.astro';
import Icon from '../ui/Icon.astro';
import { facts } from '../../content/facts';
import { contactLinks } from '../../lib/contacts';
import { NAV } from './nav';
import { landingOfPath, zamirHref } from '../../lib/landing';

interface Props {
  path: string;
}
const { path } = Astro.props;
const c = facts.contacts;
---

<div
  id="mobile-menu"
  hidden
  class="fixed inset-x-0 top-(--header-h) bottom-0 z-(--z-menu) overflow-y-auto overscroll-contain bg-plaster lg:hidden"
>
  <div class="container-site flex min-h-full flex-col gap-8 pt-4 pb-10">
    <nav aria-label="Мобільне меню">
      <ul class="divide-y divide-line border-y border-line">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="flex min-h-14 items-center justify-between font-display text-h3 font-[number:var(--font-display-weight)]"
              >
                {item.label}
                <Icon name="arrow-right" class="text-ink-muted" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col gap-3">
      <a href={contactLinks.tel} class="flex min-h-12 items-center gap-3 text-lead font-semibold">
        <Icon name="phone" />
        <Fact value={c.phoneDisplay} />
      </a>
      <div class="grid grid-cols-2 gap-3">
        <Button href={contactLinks.viber} variant="outline" icon="viber">Viber</Button>
        <Button href={contactLinks.telegram} variant="outline" icon="telegram">Telegram</Button>
      </div>
    </div>

    <Button href={zamirHref(landingOfPath(path))} size="lg" fullWidth ctaPriority={3} data-zamir-open>Безкоштовний замір</Button>
  </div>
</div>
