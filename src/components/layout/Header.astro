---
// Блок 0 — шапка (ТЗ). Закреплена при прокрутке.
// < 1024 px: логотип, звонок, бургер. ≥ 1024 px: меню, телефон, «Порахувати вартість» (ТЗ v2).
// На посадочных (/kukhni, /mebli) — переключатель «Кухні · Меблі» с выделенным активным пунктом;
// на телефоне тогда вместо полного логотипа знак (угольник + В), чтобы всё поместилось в одну строку.
import Button from '../ui/Button.astro';
import Fact from '../ui/Fact.astro';
import Icon from '../ui/Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { facts } from '../../content/facts';
import { contactLinks } from '../../lib/contacts';
import { NAV } from './nav';
import { landingOfPath, pagePath, quizHref } from '../../lib/landing';

const path = pagePath(Astro.url);
const landing = landingOfPath(path);
const SWITCH = [
  { id: 'kukhni', label: 'Кухні', href: '/kukhni' },
  { id: 'mebli', label: 'Меблі', href: '/mebli' },
] as const;
---

<header data-header class="site-header sticky top-0 z-(--z-header) bg-plaster">
  <div class="container-site flex h-(--header-h) items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <a href="/" class="-ml-1 flex min-h-12 shrink-0 items-center px-1" aria-label="Вимір — на головну">
        {
          landing ? (
            <>
              <img src="/brand/mark.svg" alt="" width="32" height="32" class="h-8 w-auto sm:hidden" />
              <img src="/brand/logo.svg" alt="" width="148" height="32" class="hidden h-8 w-auto sm:block lg:h-9" />
            </>
          ) : (
            <img src="/brand/logo.svg" alt="" width="148" height="32" class="h-8 w-auto lg:h-9" />
          )
        }
      </a>
      {
        landing && (
          <nav aria-label="Кухні або меблі" class="switch" data-landing-switch>
            {SWITCH.map((s) => (
              <a href={s.href} class="switch__item" aria-current={s.id === landing ? 'page' : undefined}>
                {s.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <nav aria-label="Головне меню" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="nav-link flex min-h-12 items-center rounded-md px-3 font-medium"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={contactLinks.tel} class="flex min-h-12 items-center gap-2 font-semibold">
        <Icon name="phone" size={20} />
        <Fact value={facts.contacts.phoneDisplay} />
      </a>
      <Button href={quizHref(landing)} deferPrimary ctaPriority={1}>Порахувати вартість</Button>
    </div>

    <div class="flex items-center lg:hidden">
      <a
        href={contactLinks.tel}
        class="grid size-12 place-items-center rounded-md"
        aria-label="Подзвонити"
      >
        <Icon name="phone" />
      </a>
      <button
        type="button"
        data-menu-toggle
        class="menu-toggle grid size-12 place-items-center rounded-md"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Меню"
      >
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
  <MobileMenu path={path} />
</header>

<style>
  .site-header {
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .site-header[data-scrolled] {
    box-shadow: var(--shadow-raised);
  }
  /* Переключатель посадочных: два сегмента, активный — графит (не жёлтый: жёлтый только для заявки) */
  .switch {
    display: flex;
    padding: 0.125rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    background: var(--color-white);
  }
  .switch__item {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: var(--radius-full);
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .switch__item[aria-current='page'] {
    background: var(--color-graphite);
    color: var(--color-plaster);
  }
  .switch__item:focus-visible {
    outline: 2px solid var(--color-graphite);
    outline-offset: 2px;
  }
  .nav-link:hover {
    background: var(--color-white);
  }
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  /* Иконки рендерит дочерний Icon — scoped-стили до него не доходят, поэтому :global */
  .menu-toggle :global(.icon-close),
  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }
</style>

<script>
  // Тень шапки после прокрутки и мобильное меню: aria-expanded, Esc, возврат фокуса
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  if (toggle && menu) {
    // Пока меню открыто, всё под ним недоступно для Tab и скринридера (фокус-ловушка через inert)
    const background = () =>
      document.querySelectorAll<HTMLElement>('main, footer, [data-bottom-bar], [data-skip-link]');

    const setOpen = (open: boolean, restoreFocus = true) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      background().forEach((el) => (el.inert = open));
      document.documentElement.toggleAttribute('data-menu-open', open);
      if (open) menu.querySelector<HTMLElement>('a, button')?.focus();
      else if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false, false);
    });
    // На десктопе меню не нужно
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) setOpen(false, false);
    });
  }
</script>
