---
// Google Analytics 4, Google Ads и Meta Pixel (фаза 7). Только боевая сборка (SITE_ENV=production) и только с заданным ID:
// PUBLIC_GA4_ID, PUBLIC_GADS_ID (AW-…, 2026-10-24), PUBLIC_META_PIXEL_ID. Без ID тег не выводится, сборка не падает.
// PUBLIC_GADS_LEAD — send_to конверсии «заявка» (AW-…/метка), уходит при успешной отправке формы (src/lib/tags.ts).
// GA4 и Google Ads — один gtag.js: грузится по первому заданному ID, config — для каждого.
// GA4: page_view (автоматически), события — src/lib/tags.ts. Pixel: PageView на каждой странице, Lead, Contact.
// Клики по телефону и мессенджерам ловит один обработчик на документе.
// Два пикселя Meta на всех страницах: основной (PUBLIC_META_PIXEL_ID) и «Вимір» (PUBLIC_META_PIXEL_ID_VYMIR, 2026-11-04);
// fbq('track') уходит во все инициализированные пиксели, поэтому PageView, Lead и Contact получают оба.
// TikTok Pixel (PUBLIC_TIKTOK_PIXEL_ID, 2026-11-04) — на всех страницах: page() при загрузке, SubmitForm и Contact — src/lib/tags.ts.
import { PUBLIC_GA4_ID, PUBLIC_GADS_ID, PUBLIC_GADS_LEAD, PUBLIC_META_PIXEL_ID, PUBLIC_META_PIXEL_ID_VYMIR, PUBLIC_TIKTOK_PIXEL_ID, SITE_ENV } from 'astro:env/client';

const prod = SITE_ENV === 'production';
const ga4 = prod && PUBLIC_GA4_ID ? PUBLIC_GA4_ID : '';
const gads = prod && PUBLIC_GADS_ID ? PUBLIC_GADS_ID : '';
const gadsLead = gads && PUBLIC_GADS_LEAD ? PUBLIC_GADS_LEAD : '';
const gtagIds = [ga4, gads].filter(Boolean);
const pixels = prod ? [...new Set([PUBLIC_META_PIXEL_ID, PUBLIC_META_PIXEL_ID_VYMIR].filter(Boolean))] : [];
const tiktok = prod && PUBLIC_TIKTOK_PIXEL_ID ? PUBLIC_TIKTOK_PIXEL_ID : '';
---

{
  tiktok && (
    <script is:inline define:vars={{ tiktok }}>
      !(function (w, d, t) {
        w.TiktokAnalyticsObject = t;
        var ttq = (w[t] = w[t] || []);
        ttq.methods = ['page', 'track', 'identify', 'instances', 'debug', 'on', 'off', 'once', 'ready', 'alias', 'group', 'enableCookie', 'disableCookie', 'holdConsent', 'revokeConsent', 'grantConsent'];
        ttq.setAndDefer = function (t, e) {
          t[e] = function () {
            t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
          };
        };
        for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
        ttq.instance = function (t) {
          for (var e = ttq._i[t] || [], n = 0; n < ttq.methods.length; n++) ttq.setAndDefer(e, ttq.methods[n]);
          return e;
        };
        ttq.load = function (e, n) {
          var r = 'https://analytics.tiktok.com/i18n/pixel/events.js';
          ttq._i = ttq._i || {};
          ttq._i[e] = [];
          ttq._i[e]._u = r;
          ttq._t = ttq._t || {};
          ttq._t[e] = +new Date();
          ttq._o = ttq._o || {};
          ttq._o[e] = n || {};
          n = d.createElement('script');
          n.type = 'text/javascript';
          n.async = !0;
          n.src = r + '?sdkid=' + e + '&lib=' + t;
          e = d.getElementsByTagName('script')[0];
          e.parentNode.insertBefore(n, e);
        };
        ttq.load(tiktok);
        ttq.page();
      })(window, document, 'ttq');
    </script>
  )
}

{gtagIds.length > 0 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`} />}
{
  gtagIds.length > 0 && (
    <script is:inline define:vars={{ gtagIds, gadsLead }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      gtagIds.forEach((id) => window.gtag('config', id));
      if (gadsLead) window.vymirAdsLead = gadsLead;
    </script>
  )
}
{
  pixels.length > 0 && (
    <script is:inline define:vars={{ pixels }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      pixels.forEach((id) => window.fbq('init', id));
      window.fbq('track', 'PageView');
    </script>
  )
}
<script>
  // Без gtag и fbq (не боевая сборка, ID не заданы) contactClicked ничего не делает
  import { contactClicked } from '../../lib/tags';
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (a) contactClicked(a.getAttribute('href') ?? '');
  });
</script>
