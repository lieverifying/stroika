---
// <head> для SEO: title, description, robots, canonical, Open Graph 1200 × 630, JSON-LD, код Google Search Console.
// Индексируется только боевая сборка (SITE_ENV=production) и только страницы без noindex.
import { PUBLIC_GSC_VERIFICATION, SITE_ENV } from 'astro:env/client';
import { pagePath } from '../../lib/landing';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Картинка Open Graph из public/og/ (1200 × 630); по умолчанию — главная */
  ogImage?: string;
  /** Схемы JSON-LD (LocalBusiness, FAQPage) */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, ogImage = '/og/home.jpg', jsonLd = [] } = Astro.props;
const robots = noindex || SITE_ENV !== 'production' ? 'noindex, nofollow' : 'index, follow';
// Канонический адрес без «.html» — как ссылки на сайте (/kukhni)
const canonical = new URL(pagePath(Astro.url), Astro.site);
const image = new URL(ogImage, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{PUBLIC_GSC_VERIFICATION && SITE_ENV === 'production' && <meta name="google-site-verification" content={PUBLIC_GSC_VERIFICATION} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Вимір" />
<meta property="og:locale" content="uk_UA" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
{jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
