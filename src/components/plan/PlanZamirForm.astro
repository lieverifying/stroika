---
// Запасной вариант на лендингах (якорь #zamir): нет плана, фото или размеров — короткая форма безкоштовного заміру.
// kitchen — /planuvannya («Замір з лендингу», Lead planuvannya_zamir), mebli — /planuvannya-mebli
// («Замір з лендингу меблів», Lead planuvannya_mebli_zamir).
// Ім'я, телефон, зручний час, згода. Кнопка графитовая: главная цель страницы остаётся «Надіслати план».
// Успех → Lead в Pixel, /dyakuyemo с общим текстом («Зателефонуємо у робочий час»). Тип заявки первой строкой — api/lead-lib.php.
import Button from '../ui/Button.astro';
import ConsentCheckbox from '../ui/form/ConsentCheckbox.astro';
import Honeypot from '../ui/form/Honeypot.astro';
import Input from '../ui/form/Input.astro';
import PhoneInput from '../ui/form/PhoneInput.astro';
import Select from '../ui/form/Select.astro';
import '../ui/form/field.css';

interface Props {
  variant: 'kitchen' | 'mebli';
}
const { variant } = Astro.props;
const cfg =
  variant === 'mebli'
    ? { form: 'zamir_mebli', landing: 'planuvannya-mebli', content: 'planuvannya_mebli_zamir' }
    : { form: 'zamir', landing: 'planuvannya', content: 'planuvannya_zamir' };
const TIMES = [
  { value: 'soon', label: 'Найближчим часом' },
  { value: 'morning', label: 'Зранку' },
  { value: 'day', label: 'Вдень' },
  { value: 'evening', label: 'Увечері' },
];
---

<form
  class="zamir-lite"
  action="/api/lead.php"
  method="post"
  novalidate
  data-plan-zamir-form
  data-form-type={cfg.form}
  data-landing={cfg.landing}
  data-content={cfg.content}
>
  <input type="hidden" name="form" value={cfg.form} />
  <input type="hidden" name="landing" value={cfg.landing} />
  <input type="hidden" name="contactMethod" value="call" />
  <Input name="name" id="pz-name" label="Ім’я" autocomplete="given-name" required error="Вкажіть, як до вас звертатися" />
  <PhoneInput id="pz-phone" />
  <Select name="time" id="pz-time" label="Зручний час для дзвінка" options={TIMES} />
  <ConsentCheckbox id="pz-consent" />
  <Honeypot id="pz-website" />
  <Button type="submit" variant="secondary" size="lg" fullWidth>Замовити замір</Button>
  <p class="zamir-lite__status" role="status" aria-live="polite" data-form-status></p>
</form>

<style>
  .zamir-lite {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .zamir-lite__status:empty {
    display: none;
  }
  .zamir-lite__status {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  @media (min-width: 48rem) {
    .zamir-lite {
      padding: 2rem;
    }
  }
</style>

<script>
  import { clearErrorsOnFix, validateForm } from '../../lib/lead/field-errors';
  import { saveThanks } from '../../lib/lead/result-store';
  import { showSendError } from '../../lib/lead/send-error';
  import { submitLead } from '../../lib/lead/submit';
  import { validateConsent, validateName, validatePhone } from '../../lib/lead/validate';
  import { normalizePhone } from '../../lib/phone';
  import { leadSucceeded } from '../../lib/tags';
  import { track } from '../../lib/track';

  type Field = HTMLInputElement | HTMLTextAreaElement;
  const CHECKS = {
    name: (f: Field) => validateName(f.value),
    phone: (f: Field) => validatePhone(f.value),
    consent: (f: Field) => validateConsent((f as HTMLInputElement).checked),
  };

  document.querySelectorAll<HTMLFormElement>('form[data-plan-zamir-form]').forEach((form) => {
    const { formType = 'zamir', landing = 'planuvannya', content = 'planuvannya_zamir' } = form.dataset;
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    clearErrorsOnFix(form, CHECKS);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateForm(form, CHECKS)) {
        if (status) status.textContent = '';
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      if (status) status.textContent = 'Надсилаємо…';
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const res = await submitLead({
        contactMethod: 'call',
        form: formType,
        landing,
        name,
        phone: normalizePhone(String(data.get('phone') ?? '')),
        time: String(data.get('time') ?? ''),
        consent: true,
        website: data.get('website') ?? '',
      });
      if (res.ok) {
        track('lead_submit', { form: formType, landing, content_name: content });
        leadSucceeded(formType, content);
        saveThanks({ name, method: 'call', result: null });
        location.assign('/dyakuyemo');
      } else {
        if (button) button.disabled = false;
        showSendError(status);
      }
    });
  });
</script>
