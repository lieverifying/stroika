---
// Лендинг под рекламу Meta (решения владельца, 2026-10-22): /planuvannya (кухня) и /planuvannya-mebli (шафи та меблі).
// Одна цель — заявка на лид-магнит «два варіанти»; запасной вариант — безкоштовний замір. Только логотип: без меню,
// переключателя, подвала и нижней панели; noindex всегда. Структура:
// 1 первый экран (жёлтая кнопка → #plan, «Надіслати у Viber»; кнопки на сайт здесь нет) → 2 «Як це працює» (4 шага)
// → 3 форма лид-магнита (#plan) и форма заміру (#zamir) → 4 роботи + «Переглянути сайт» → 5 три вопроса
// → 6 финал: жёлтая кнопка к форме, под ней «Переглянути сайт». Срок — facts.leadMagnet.planHours.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import PlanForm from './PlanForm.astro';
import PlanZamirForm from './PlanZamirForm.astro';
import PortfolioGrid from '../portfolio/PortfolioGrid.astro';
import Lightbox from '../portfolio/Lightbox.astro';
import Accordion from '../ui/Accordion.astro';
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { contactLinks } from '../../lib/contacts';
import { responsive, type PortfolioItem, type PortfolioPhoto } from '../../lib/portfolio';

export interface PlanFaq {
  q: string;
  /** Ответ; ссылка на форму заміру (#zamir) — необязательная середина ответа */
  a: string;
  zamirLink?: { text: string; after: string };
}

interface Props {
  variant: 'kitchen' | 'mebli';
  title: string;
  description: string;
  h1: string;
  lead: string;
  photo: PortfolioPhoto;
  focus?: string;
  ctaLabel: string;
  steps: string[];
  formTitle: string;
  formSubtitle: string;
  zamirTitle: string;
  works: PortfolioItem[];
  worksWide?: boolean;
  worksWideIds?: string[];
  worksCols?: [number, number];
  faq: PlanFaq[];
  finalTitle: string;
  /** «Переглянути сайт»: /planuvannya → главная, /planuvannya-mebli → /mebli */
  siteHref: string;
}
const p = Astro.props;
---

<BaseLayout
  title={p.title}
  description={p.description}
  noindex
  bare
  compactH2
  lcpImage={{ srcset: responsive(p.photo).srcset, sizes: '(min-width: 64rem) 40vw, 100vw' }}
>
  <header class="plan-top container-site">
    <img src="/brand/logo.svg" alt="Вимір" width="148" height="32" />
  </header>

  <Hero
    title={p.h1}
    lead={p.lead}
    photo={p.photo}
    focus={p.focus ?? '50% 50%'}
    quizHref="#plan"
    ctaLabel={p.ctaLabel}
    ctaIcon="arrow-right"
    viberLabel="Надіслати у Viber"
  />

  <section class="section-pad" aria-labelledby="how-title" data-block="how">
    <div class="container-site">
      <SectionTitle id="how-title" title="Як це працює" />
      <ol class="plan-steps">
        {
          p.steps.map((s, i) => (
            <li class="plan-steps__item">
              <span class="plan-steps__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="plan-steps__text">{s}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="plan" class="section-pad" aria-labelledby="plan-title" data-block="plan-form">
    <div class="container-site plan-forms">
      <div class="plan-forms__main">
        <SectionTitle id="plan-title" title={p.formTitle} subtitle={p.formSubtitle} />
        <PlanForm variant={p.variant} />
      </div>
      <div id="zamir" class="plan-forms__zamir" data-block="plan-zamir">
        <h2 class="plan-forms__zamir-title">{p.zamirTitle}</h2>
        <PlanZamirForm variant={p.variant} />
      </div>
    </div>
  </section>

  <section class="section-pad" aria-labelledby="plan-works-title" data-block="3" data-gallery>
    <div class="container-site plan-works">
      <SectionTitle id="plan-works-title" title="Роботи нашої команди" />
      <PortfolioGrid items={p.works} eager={0} cols={p.worksCols ?? [2, 3]} wide={p.worksWide} wideIds={p.worksWideIds} />
      <div class="plan-works__site">
        <Button href={p.siteHref} variant="outline" icon="arrow-right" data-site-link>Переглянути сайт</Button>
      </div>
    </div>
    <Lightbox />
  </section>

  <section class="section-pad" aria-labelledby="plan-faq-title" data-block="12">
    <div class="container-site plan-faq">
      <SectionTitle id="plan-faq-title" title="Питання" />
      <div class="plan-faq__list">
        {
          p.faq.map((f) => (
            <Accordion summary={f.q} name="plan-faq">
              <p>
                {f.a}
                {f.zamirLink && (
                  <>
                    <a href="#zamir">{f.zamirLink.text}</a>
                    {f.zamirLink.after}
                  </>
                )}
              </p>
            </Accordion>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad plan-final on-dark" aria-labelledby="plan-final-title" data-block="13">
    <div class="container-site plan-final__inner">
      <h2 id="plan-final-title" class="text-h2">{p.finalTitle}</h2>
      <div class="plan-final__buttons">
        <Button href="#plan" size="lg" icon="arrow-right" ctaPriority={3}>{p.ctaLabel}</Button>
        <Button href={contactLinks.viber} variant="light" icon="viber">Надіслати у Viber</Button>
      </div>
      <Button href={p.siteHref} variant="outline" icon="arrow-right" data-site-link>Переглянути сайт</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .plan-top {
    display: flex;
    align-items: center;
    min-height: var(--header-h);
  }
  .plan-top img {
    height: 2rem;
    width: auto;
  }
  .plan-steps {
    display: grid;
    gap: var(--grid-gap);
  }
  .plan-steps__item {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .plan-steps__num {
    font-family: var(--font-mono);
    font-size: var(--text-lead);
    color: var(--color-oak);
  }
  .plan-steps__text {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    font-weight: 600;
  }
  .plan-forms {
    display: grid;
    gap: var(--space-section);
    max-width: calc(48rem + 2 * var(--space-gutter));
  }
  .plan-forms__zamir {
    display: grid;
    gap: 1.25rem;
    scroll-margin-top: 1rem;
  }
  .plan-forms__zamir-title {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
  }
  .plan-works__site {
    display: flex;
    justify-content: center;
    margin-top: var(--space-stack);
  }
  .plan-faq {
    max-width: calc(48rem + 2 * var(--space-gutter));
  }
  .plan-faq a {
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .plan-final {
    background: var(--color-graphite);
    color: var(--color-plaster);
  }
  .plan-final__inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .plan-final__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .plan-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .plan-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
