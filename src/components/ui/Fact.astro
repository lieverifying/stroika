---
// Выводит факт из facts.ts или видимую заглушку (ARCHITECTURE.md 5.3). missing('NAME') — ничего не выводит:
// блок с отсутствующим фактом должен быть скрыт целиком (режим запуска, «нет факта — нет блока»).
// Заглушка — моноширинная серая плашка с пунктиром, НЕ жёлтая.
// Строка с заглушкой внутри текста («Кутова кухня {{CASE_FACADE_DESCRIPTION}}») — плашкой становится только заглушка.
import type { Fact } from '../../content/facts';
import { isMissing, isPlaceholder, placeholderName } from '../../lib/facts';

interface Props {
  value: Fact<string | number>;
  /** Форматирование реального значения, например formatUAH */
  format?: (v: never) => string;
  class?: string;
}

const { value, format, class: className } = Astro.props;
const absent = isMissing(value);
const placeholder = !absent && isPlaceholder(value);
const text = absent ? '' : placeholder ? (value as string) : format ? format(value as never) : String(value);
// Части строки: чётные — обычный текст, нечётные — заглушки
const parts = !placeholder && typeof value === 'string' && value.includes('{{') ? value.split(/(\{\{[A-Z0-9_]+\}\})/) : null;
---

{
  absent ? null : parts ? (
    <span class={className}>
      {parts.map((part, i) =>
        i % 2 ? (
          <span class="fact-ph" data-placeholder={part.slice(2, -2)}>
            {part}
          </span>
        ) : (
          part
        ),
      )}
    </span>
  ) : placeholder ? (
    <span class:list={['fact-ph', className]} data-placeholder={placeholderName(value as string & `{{${string}}}`)}>
      {text}
    </span>
  ) : (
    <span class={className}>{text}</span>
  )
}

<style>
  .fact-ph {
    display: inline-block;
    max-width: 100%;
    padding: 0 0.25em;
    font-family: var(--font-mono);
    font-size: max(1rem, 0.8em); /* CLAUDE.md: текст на телефоне ≥ 16 px, и у заглушек тоже */
    line-height: 1.4;
    letter-spacing: 0;
    vertical-align: 0.05em;
    color: var(--color-graphite);
    background: var(--color-placeholder);
    border: 1px dashed var(--color-graphite);
    border-radius: var(--radius-sm);
    overflow-wrap: anywhere;
    hyphens: none;
  }
</style>
