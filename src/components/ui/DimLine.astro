---
// Фирменный мотив (ТЗ v2): тонкая размерная линия с засечками и подписью в мм. 2–3 раза на страницу, как деталь.
// Горизонтальная — подпись над линией по центру; вертикальная — подпись сбоку, повёрнута.
// Декоративная: aria-hidden.
interface Props {
  label: string;
  vertical?: boolean;
  class?: string;
}
const { label, vertical = false, class: className } = Astro.props;
---

<span class:list={['dim', vertical ? 'dim--v' : 'dim--h', className]} aria-hidden="true">
  <span class="dim__line"></span>
  <span class="dim__label">{label}</span>
</span>

<style>
  .dim {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-oak);
    font-family: var(--font-mono);
    font-size: var(--text-dim);
    line-height: 1;
    letter-spacing: 0.02em;
    pointer-events: none;
    hyphens: none;
  }
  .dim__line {
    position: absolute;
    background: currentColor;
  }
  /* Засечки на концах — косые, как на чертеже */
  .dim__line::before,
  .dim__line::after {
    content: '';
    position: absolute;
    width: 1px;
    height: 0.75rem;
    background: currentColor;
    transform: rotate(45deg);
  }

  .dim--h {
    width: 100%;
    height: 1.75rem;
  }
  .dim--h .dim__line {
    left: 0;
    right: 0;
    bottom: 0.375rem;
    height: 1px;
  }
  .dim--h .dim__line::before,
  .dim--h .dim__line::after {
    top: -0.375rem;
  }
  .dim--h .dim__line::before {
    left: 0;
  }
  .dim--h .dim__line::after {
    right: 0;
  }
  .dim--h .dim__label {
    padding-bottom: 0.875rem;
    white-space: nowrap;
  }

  .dim--v {
    width: 1.75rem;
    height: 100%;
  }
  .dim--v .dim__line {
    top: 0;
    bottom: 0;
    left: 0.375rem;
    width: 1px;
  }
  .dim--v .dim__line::before,
  .dim--v .dim__line::after {
    left: 0;
  }
  .dim--v .dim__line::before {
    top: -0.375rem;
  }
  .dim--v .dim__line::after {
    bottom: -0.375rem;
  }
  .dim--v .dim__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding-right: 0.875rem;
    white-space: nowrap;
  }
</style>
