---
// Согласие на обработку данных: по умолчанию НЕ отмечено, ссылка на /polityka. Зона нажатия ≥ 48 px.
import './field.css';

interface Props {
  id?: string;
}
const { id = 'f-consent' } = Astro.props;
---

<div class="field consent">
  <label class="consent__label" for={id}>
    <input class="consent__box" type="checkbox" id={id} name="consent" value="yes" required />
    <span>Погоджуюсь на обробку персональних даних згідно з <a href="/polityka">політикою конфіденційності</a></span>
  </label>
  <p class="field__error" id={`${id}-error`} data-error="Потрібна ваша згода" hidden>Потрібна ваша згода</p>
</div>

<style>
  .consent__label {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    min-height: var(--control-h);
    padding-block: 0.75rem;
    font-size: var(--text-small);
    cursor: pointer;
  }
  .consent__label a {
    position: relative;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .consent__box {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--color-graphite);
  }
  .consent__box[aria-invalid='true'] {
    outline: 2px solid var(--color-error);
    outline-offset: 2px;
  }
</style>
