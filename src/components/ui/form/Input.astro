---
// Текстовое поле с подписью, подсказкой и местом под ошибку (aria-describedby → подсказка и ошибка).
// Ошибку показывает скрипт формы: снимает hidden у .field__error, ставит aria-invalid и добавляет id ошибки
// в aria-describedby (скрытую ошибку туда не ставим — скринридер прочитал бы её и у верного поля).
import type { HTMLAttributes } from 'astro/types';
import './field.css';

interface Props extends Omit<HTMLAttributes<'input'>, 'id' | 'name'> {
  name: string;
  label: string;
  id?: string;
  hint?: string;
  /** Текст ошибки, который покажет скрипт формы */
  error?: string;
  /** Не писать «(необов’язково)» у необязательного поля (когда это сказано в общей подписи группы) */
  hideOptional?: boolean;
}

const { name, label, id = `f-${name}`, hint, error = 'Заповніть це поле', required, hideOptional = false, class: className, ...rest } = Astro.props;
const describedBy = hint ? `${id}-hint` : undefined;
---

<div class:list={['field', className]}>
  <label class="field__label" for={id}>
    {label}
    {!required && !hideOptional && <span class="field__optional"> (необов’язково)</span>}
  </label>
  <input class="field__control" id={id} name={name} required={required} aria-describedby={describedBy} {...rest} />
  {hint && <p class="field__hint" id={`${id}-hint`}>{hint}</p>}
  <p class="field__error" id={`${id}-error`} data-error={error} hidden>{error}</p>
</div>
