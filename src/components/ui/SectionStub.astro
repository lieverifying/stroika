---
// ВРЕМЕННО (фаза 3): пустое место блока до его задачи в PLAN.md. Удаляется, когда все блоки готовы.
interface Props {
  task: string;
  minHeight?: string;
}
const { task, minHeight = '12rem' } = Astro.props;
---

<div class="stub" style={`min-height: ${minHeight}`} aria-hidden="true">
  <span>Блок у роботі · задача {task}</span>
</div>

<style>
  .stub {
    display: grid;
    place-items: center;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-align: center;
    color: var(--color-ink-muted);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-md);
  }
</style>
