---
// Чип фильтра: кнопка-переключатель с aria-pressed. Высота 48 px, выбранный — графит (не жёлтый: жёлтый только для заявки).
interface Props {
  value: string;
  pressed?: boolean;
}
const { value, pressed = false } = Astro.props;
---

<button type="button" class="chip" data-value={value} aria-pressed={pressed ? "true" : "false"}>
  <slot />
</button>

<style>
  .chip {
    flex: none;
    min-height: var(--control-h);
    padding-inline: 1.25rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-graphite);
    font-size: var(--text-small);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .chip:hover {
    border-color: var(--color-graphite);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-graphite);
    border-color: var(--color-graphite);
    color: var(--color-plaster);
  }
</style>
