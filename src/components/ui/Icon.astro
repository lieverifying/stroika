---
// Иконки 24×24 inline SVG, линия 2 px, цвет — currentColor. Мессенджеры — в палитре сайта, не в фирменных цветах.
export type IconName = 'phone' | 'viber' | 'telegram' | 'instagram' | 'tiktok' | 'menu' | 'close' | 'arrow-right' | 'calculator';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Подпись для скринридеров; без неё иконка скрыта (aria-hidden) */
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
  phone:
    '<path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  viber:
    '<path d="M12 3c-5 0-8 2-8 7.5 0 3 1 5 3 6V20l3-2.5c.6.1 1.3.1 2 .1 5 0 8-2 8-7.6S17 3 12 3"/><path d="M9.5 8.5c.5 2.5 2.5 4.5 5 5M13 7a3 3 0 0 1 3 3"/>',
  telegram: '<path d="m21 4-18 7 6 2 2 6 3-4 5 4z"/><path d="m9 13 8-6"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17 7h.01"/>',
  tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.3 2.6 2 4.4 5 4.6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  calculator:
    '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
