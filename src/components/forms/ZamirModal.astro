---
// Попап замера из шапки (ТЗ, блок 0): нативный <dialog> с той же формой, что в блоке 13.
// Открывается кнопкой с data-zamir-open (без JS это обычная ссылка на /#zamir).
// Закрытие: крестик, Esc (нативно), клик по фону. Пока открыт — html[data-dialog-open], нижняя панель скрыта.
// На телефоне окно почти на весь экран, форма прокручивается внутри.
import ZamirForm from './ZamirForm.astro';
---

<dialog class="zamir-modal" aria-labelledby="zamir-modal-title" data-zamir-modal>
  <div class="zamir-modal__box">
    <div class="zamir-modal__head">
      <h2 id="zamir-modal-title" class="zamir-modal__title">Безкоштовний замір</h2>
      <button type="button" class="zamir-modal__close" aria-label="Закрити" data-zamir-close>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <ZamirForm idPrefix="modal" source="header-modal" ctaPriority={4} />
  </div>
</dialog>

<style>
  .zamir-modal {
    width: min(100% - 1.5rem, 32rem);
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-plaster);
    color: var(--color-graphite);
    box-shadow: var(--shadow-overlay);
    overscroll-behavior: contain;
  }
  .zamir-modal::backdrop {
    background: rgb(30 33 36 / 0.6);
  }
  .zamir-modal__box {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
  }
  .zamir-modal__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .zamir-modal__title {
    padding-top: 0.5rem;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
  }
  .zamir-modal__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin: -0.25rem -0.5rem 0 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .zamir-modal__close svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  @media (min-width: 48rem) {
    .zamir-modal__box {
      padding: 2rem;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-zamir-modal]');
  if (dialog) {
    let opener: HTMLElement | null = null;
    const sync = () => document.documentElement.toggleAttribute('data-dialog-open', dialog.open);

    document.querySelectorAll<HTMLElement>('[data-zamir-open]').forEach((btn) =>
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        opener = btn;
        dialog.showModal();
        sync();
        dialog.querySelector<HTMLInputElement>('input:not([type=hidden]):not([tabindex="-1"])')?.focus();
      }),
    );
    dialog.querySelector('[data-zamir-close]')?.addEventListener('click', () => dialog.close());
    // Клик по фону: событие приходит на сам <dialog>. Закрываем, только если и нажатие было на фоне —
    // иначе выделение текста в поле с отпусканием над фоном закрыло бы форму и стёрло ввод.
    let downOnBackdrop = false;
    dialog.addEventListener('mousedown', (e) => {
      downOnBackdrop = e.target === dialog;
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog && downOnBackdrop) dialog.close();
      downOnBackdrop = false;
    });
    dialog.addEventListener('close', () => {
      sync();
      // Кнопка в закрытом мобильном меню невидима — тогда фокус на бургер
      const target = opener && opener.offsetParent !== null ? opener : document.querySelector<HTMLElement>('[data-menu-toggle]');
      target?.focus();
    });
  }
</script>
