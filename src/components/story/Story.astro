---
// Сюжет «Як ми створюємо» (решение владельца, 2026-10-21): этапы одного изделия на одной сцене 4:3.
// Данные — src/content/stories/<id>.json; кадры — src/assets/stories/ (визуализации, подпись «Візуалізація етапів»),
// нет кадра — серый плейсхолдер с подписью этапа.
// Режимы:
// — по умолчанию (без JS и при prefers-reduced-motion) этапы идут друг под другом, статично;
// — скрипт включает .story--scroll: сцена закреплена (sticky) на высоту экрана, этап сменяется каждые 70svh прокрутки,
//   кадр и подпись — перекрёстным затуханием (только opacity и transform). Сбоку индикатор этапов — он же кнопки
//   перехода (клик, стрелки). Грузится текущий и следующий кадр; без JS кадры — из <noscript>.
// Кадр — WebP при сборке, до 200 КБ.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PlaceholderImage from '../ui/PlaceholderImage.astro';
import KitchenWallDims from './KitchenWallDims.astro';

export interface StoryStage {
  title: string;
  text: string;
  /** путь от src/assets/stories/, null — кадра пока нет */
  image: string | null;
  alt: string;
  overlay?: 'kitchen-wall';
}
export interface StoryData {
  id: string;
  title: string;
  stages: StoryStage[];
}
interface Props {
  story: StoryData;
}
const { story } = Astro.props;
const n = story.stages.length;
const pad = (i: number) => String(i).padStart(2, '0');

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/stories/**/*.{png,jpg,jpeg,webp}', { eager: true });
const SIZES = '(min-width: 80rem) 46rem, (min-width: 64rem) 58vw, calc(100vw - 2rem)';

const stages = await Promise.all(
  story.stages.map(async (s) => {
    if (!s.image) return { ...s, img: null };
    const file = files[`../../assets/stories/${s.image}`];
    if (!file) throw new Error(`Сюжет «${story.id}»: нет кадра src/assets/stories/${s.image}`);
    const img = await getImage({ src: file.default, widths: [480, 800, 1200, 1448], format: 'webp', quality: 72 });
    return { ...s, img };
  }),
);
---

<section class="story" data-story={story.id} aria-labelledby={`story-${story.id}-title`} style={`--n: ${n}`}>
  <h2 id={`story-${story.id}-title`} class="text-h2 story__heading">{story.title}</h2>
  <div class="story__track">
    <div class="story__sticky">
      <ol class="story__list">
        {
          stages.map((s, i) => (
            <li class="story__step" data-step={i}>
              <div class="story__media">
                <div class="story__frame">
                  {s.img ? (
                    i === 0 ? (
                      <img
                        class="story__img"
                        src={s.img.src}
                        srcset={s.img.srcSet.attribute}
                        sizes={SIZES}
                        width={s.img.attributes.width}
                        height={s.img.attributes.height}
                        alt={s.alt}
                        fetchpriority="high"
                      />
                    ) : (
                      <>
                        <img
                          class="story__img"
                          data-src={s.img.src}
                          data-srcset={s.img.srcSet.attribute}
                          sizes={SIZES}
                          width={s.img.attributes.width}
                          height={s.img.attributes.height}
                          alt={s.alt}
                          loading="lazy"
                        />
                        <noscript>
                          <img
                            class="story__img"
                            src={s.img.src}
                            srcset={s.img.srcSet.attribute}
                            sizes={SIZES}
                            width={s.img.attributes.width}
                            height={s.img.attributes.height}
                            alt={s.alt}
                            loading="lazy"
                          />
                        </noscript>
                      </>
                    )
                  ) : (
                    <PlaceholderImage width={1600} height={1200} label={`${story.title.toLowerCase()}, етап «${s.title}», 4:3`} />
                  )}
                  {s.overlay === 'kitchen-wall' && <KitchenWallDims />}
                </div>
                {s.img && <p class="story__note">Візуалізація етапів</p>}
              </div>
              <div class="story__caption">
                <p class="story__num">
                  {pad(i + 1)} / {pad(n)}
                </p>
                <h3 class="story__title">{s.title}</h3>
                <p class="story__text">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="story__progress" role="group" aria-label={`Етапи: ${story.title}`} hidden>
        {
          stages.map((s, i) => (
            <button type="button" class="story__dot" data-go={i} aria-label={`${i + 1}. ${s.title}`} tabindex={i === 0 ? 0 : -1}>
              <span />
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    --sticky-h: calc(100svh - var(--header-h) - var(--bottom-bar-h));
    display: grid;
    gap: 1.5rem;
  }
  .story__heading {
    margin: 0;
  }

  /* ——— Статичный режим: этапы друг под другом ——— */
  .story__list {
    display: grid;
    gap: 2.5rem;
  }
  .story__step {
    display: grid;
    gap: 1rem;
  }
  .story__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .story__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .story__frame :global(.ph) {
    height: 100%;
    aspect-ratio: auto;
  }
  .story__note {
    margin-top: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .story__caption {
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }
  .story__num {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .story__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: var(--font-display-weight);
  }
  .story__text {
    max-width: 40ch;
  }
  @media (min-width: 64rem) {
    .story__step {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--grid-gap);
      align-items: center;
    }
  }

  /* ——— Режим прокрутки (включает скрипт) ——— */
  .story--scroll .story__track {
    height: calc(var(--sticky-h) + var(--n) * 70svh);
  }
  .story--scroll .story__sticky {
    position: sticky;
    top: var(--header-h);
    height: var(--sticky-h);
    padding-block: 1rem;
  }
  .story--scroll .story__list {
    position: relative;
    display: block;
    height: 100%;
  }
  .story--scroll .story__step {
    position: absolute;
    inset: 0;
    align-content: start;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-out);
  }
  .story--scroll .story__step[data-active] {
    opacity: 1;
    pointer-events: auto;
  }
  /* Кадр не выше экрана: ширина от доступной высоты сцены, пропорция 4:3 сохраняется */
  .story--scroll .story__frame {
    width: min(100%, calc((var(--sticky-h) - 14rem) * 4 / 3));
  }
  .story--scroll .story__caption {
    padding-right: 3.5rem;
    transform: translateY(0.75rem);
    transition: transform 0.5s var(--ease-out);
  }
  .story--scroll .story__step[data-active] .story__caption {
    transform: none;
  }
  .story__progress[hidden] {
    display: none;
  }
  .story__progress {
    position: absolute;
    right: 0;
    bottom: 1rem;
    display: grid;
  }
  .story__dot {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .story__dot span {
    width: 0.625rem;
    height: 0.625rem;
    border: 1.5px solid var(--color-graphite);
    border-radius: var(--radius-full);
    transition: transform 0.3s var(--ease-out);
  }
  .story__dot[aria-current='step'] span {
    background: var(--color-graphite);
    transform: scale(1.3);
  }
  .story__dot:focus-visible {
    outline: 2px solid var(--color-graphite);
    outline-offset: -4px;
    border-radius: var(--radius-md);
  }
  @media (min-width: 64rem) {
    .story--scroll .story__frame {
      width: min(100%, calc((var(--sticky-h) - 4rem) * 4 / 3));
    }
    .story--scroll .story__step {
      align-content: center;
    }
    .story__progress {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
  }
</style>

<script>
  import { track } from '../../lib/track';

  // Сюжеты на странице: прокрутка листает этапы; при prefers-reduced-motion — статичный список (как без JS)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('.story__step')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const trackEl = root.querySelector<HTMLElement>('.story__track')!;
    const sticky = root.querySelector<HTMLElement>('.story__sticky')!;
    const n = steps.length;
    let active = -1;
    let completed = false;

    // Кадр с отложенной загрузкой: data-srcset → srcset
    const load = (i: number) => {
      const img = steps[i]?.querySelector<HTMLImageElement>('img[data-srcset]');
      if (!img) return;
      img.srcset = img.dataset.srcset!;
      img.src = img.dataset.src!;
      img.removeAttribute('data-srcset');
    };
    // story_complete — один раз за просмотр, только сюжет кухни
    const complete = () => {
      if (completed || root.dataset.story !== 'kitchen') return;
      completed = true;
      track('story_complete', { story: 'kitchen' });
    };

    if (reduce) {
      steps.forEach((_, i) => load(i));
      const io = new IntersectionObserver((e) => {
        if (e[0].isIntersecting) {
          io.disconnect();
          complete();
        }
      });
      io.observe(steps[n - 1]);
      return;
    }

    root.classList.add('story--scroll');
    root.querySelector<HTMLElement>('.story__progress')!.hidden = false;

    const stepPx = () => innerHeight * 0.7;
    const stickyTop = () => parseFloat(getComputedStyle(sticky).top) || 0;

    const set = (i: number) => {
      if (i === active) return;
      active = i;
      steps.forEach((s, k) => {
        s.toggleAttribute('data-active', k === i);
        s.inert = k !== i;
      });
      dots.forEach((d, k) => {
        d.setAttribute('aria-current', k === i ? 'step' : 'false');
        d.tabIndex = k === i ? 0 : -1;
      });
      root.dataset.active = String(i);
      load(i);
      load(i + 1);
      if (i === n - 1) complete();
    };

    const update = () => {
      const y = stickyTop() - trackEl.getBoundingClientRect().top;
      set(Math.max(0, Math.min(n - 1, Math.floor(y / stepPx()))));
    };

    // Переход к этапу: прокрутка к середине его участка
    const go = (i: number) => {
      const k = Math.max(0, Math.min(n - 1, i));
      const top = scrollY + trackEl.getBoundingClientRect().top - stickyTop() + (k + 0.5) * stepPx();
      scrollTo({ top, behavior: 'smooth' });
      dots[k].focus({ preventScroll: true });
    };

    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.go))));
    root.addEventListener('keydown', (e) => {
      if (!(e.target as HTMLElement).matches('[data-go]')) return;
      const delta = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (!delta) return;
      e.preventDefault();
      go(active + delta);
    });

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  });
</script>
