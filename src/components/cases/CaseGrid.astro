---
// Сетка карточек кейсов: 1 колонка на телефоне, 2 на планшете, 3 на десктопе.
// mobileLimit: на телефоне (< 768 px) видно только первые N карточек — лишние помечены data-extra.
// Фильтр (CaseFilter) пересчитывает data-extra среди оставшихся карточек.
import CaseCard from './CaseCard.astro';
import type { Case } from '../../lib/cases';

interface Props {
  id?: string;
  items: Case[];
  headingLevel?: 'h2' | 'h3';
  mobileLimit?: number;
}

const { id, items, headingLevel, mobileLimit } = Astro.props;
---

<ul id={id} class="case-grid" data-case-grid data-mobile-limit={mobileLimit}>
  {
    items.map((item, i) => (
      <li
        data-shape={item.data.kitchenShape}
        data-category={item.data.category}
        data-extra={mobileLimit !== undefined && i >= mobileLimit ? '' : undefined}
      >
        <CaseCard item={item} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>

<style>
  .case-grid {
    display: grid;
    gap: var(--grid-gap);
  }
  .case-grid > li {
    display: grid;
  }
  .case-grid > li[hidden] {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .case-grid > li[data-extra] {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .case-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
