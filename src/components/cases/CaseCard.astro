---
// Карточка кейса на главной: обложка 4:3, название, район, цена «від» — и всё (правки владельца, фаза 3).
// Тип кухни — в самом названии, отдельной подписью не дублируем. Срок и материалы — только на странице кейса.
// Кликабельна вся карточка: ссылка в заголовке растянута на карточку (::after), фокус — рамкой карточки.
// data-shape / data-category — для фильтра портфолио.
import { Image } from 'astro:assets';
import Fact from '../ui/Fact.astro';
import PlaceholderImage from '../ui/PlaceholderImage.astro';
import { buildAlt, type Case } from '../../lib/cases';
import { formatUAH } from '../../lib/facts';

interface Props {
  item: Case;
  /** Заголовок карточки: h3 в блоке с h2, h2 на странице без него */
  headingLevel?: 'h2' | 'h3';
}

const { item, headingLevel = 'h3' } = Astro.props;
const { data } = item;
const Heading = headingLevel;
---

<article class="case-card" data-shape={data.kitchenShape} data-category={data.category}>
  <div class="case-card__media">
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={buildAlt(item)}
          widths={[400, 800, 1200]}
          sizes="(min-width: 64rem) 380px, (min-width: 48rem) 50vw, 100vw"
          class="case-card__img"
        />
      ) : (
        <PlaceholderImage width={1200} height={900} label="обкладинка кейсу" />
      )
    }
  </div>
  <div class="case-card__body">
    <Heading class="case-card__title">
      <a href={`/roboty/${item.id}`} class="case-card__link">
        <Fact value={data.title} />
      </a>
    </Heading>
    <p class="case-card__meta"><Fact value={data.district} /></p>
    {
      data.priceFrom !== undefined && (
        <p class="case-card__price">
          Ціна від <Fact value={data.priceFrom} format={formatUAH} class="case-card__num" />
        </p>
      )
    }
  </div>
</article>

<style>
  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .case-card:focus-within {
    outline: 2px solid var(--color-graphite);
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .case-card:hover {
      box-shadow: var(--shadow-card);
    }
  }
  .case-card__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .case-card__body {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
  }
  .case-card__meta {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    hyphens: none;
  }
  .case-card__title {
    font-family: var(--font-body);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    font-weight: 600;
  }
  /* Вся карточка — зона нажатия ссылки */
  .case-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  /* Фокус показываем рамкой карточки (focus-within), не обводкой текста */
  .case-card__link:focus-visible {
    outline: none;
  }
  .case-card__price {
    margin-top: 0.25rem;
    font-size: var(--text-small);
  }
  /* Числа — моно (ARCHITECTURE 6.3), подпись «Ціна від» — обычным шрифтом */
  .case-card__price :global(.case-card__num) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
</style>
