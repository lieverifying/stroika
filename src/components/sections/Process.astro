---
// Блок 7 — «Як працюємо» (ТЗ): 5 шагов, у каждого срок. Срок изготовления подтверждён, остальные — заглушки facts.ts.
// Телефон — вертикальная шкала с номерами, десктоп — 5 колонок, шаги соединяет размерная линия (мотив замера).
import Dimension from '../ui/Dimension.astro';
import Fact from '../ui/Fact.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { facts } from '../../content/facts';
import { pluralUk } from '../../lib/facts';

const DAYS: [string, string, string] = ['день', 'дні', 'днів'];
const { terms, promises } = facts;

// Изготовление — фабрики-партнёры по нашему проекту; срок подтверждён владельцем (от авансу). Монтаж — что входит.
const install = facts.services.install;
const steps = [
  { title: 'Заявка', text: 'Квіз, форма на сайті, дзвінок або Viber.', term: promises.callbackMinutes, unit: 'хв', prefix: 'Передзвонимо за' },
  { title: 'Замір', text: 'Безкоштовно приїжджаємо і знімаємо розміри приміщення.', term: terms.stepMeasureDays, unit: pluralUk(terms.stepMeasureDays, DAYS) },
  { title: 'Дизайн-проєкт і кошторис', text: 'Готуємо дизайн-проєкт і рахуємо вартість.', term: terms.stepProjectDays, unit: pluralUk(terms.stepProjectDays, DAYS) },
  { title: 'Договір і виготовлення', text: 'Підписуємо договір. Деталі за нашим проєктом виготовляють фабрики-партнери.', term: terms.kitchenProductionMonths, unit: 'місяці від авансу', prefix: 'Кухня —' },
  { title: 'Монтаж', text: `Встановлюємо меблі. У монтаж входять: ${install.join(', ')}.`, term: terms.stepInstallDays, unit: pluralUk(terms.stepInstallDays, DAYS) },
];
---

<section data-block="7" class="section-pad" aria-labelledby="process-title">
  <div class="container-site">
    <SectionTitle id="process-title" title="Як ми працюємо" />
    <div class="process__dim">
      <Dimension label="від заявки до монтажу" />
    </div>
    <ol class="process">
      {
        steps.map((s, i) => (
          <li class="process__step">
            <span class="process__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="process__body">
              <h3 class="process__title">{s.title}</h3>
              <p class="process__text">{s.text}</p>
              <p class="process__term">
                {s.prefix ?? 'Термін'} <Fact value={s.term} class="process__value" /> {s.unit}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    display: grid;
    gap: 0;
  }
  /* Телефон: номер в кружке, вертикальная линия к следующему шагу */
  .process__step {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
    padding-bottom: 2rem;
  }
  .process__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 3rem;
    bottom: 0;
    left: 1.5rem;
    width: 1px;
    background: var(--color-line-strong);
  }
  .process__num {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-full);
    background: var(--color-plaster);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
  }
  .process__body {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.625rem;
  }
  .process__title {
    font-family: var(--font-body);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    font-weight: 600;
  }
  .process__text {
    color: var(--color-ink-muted);
  }
  .process__term {
    font-size: var(--text-small);
  }
  .process__term :global(.process__value) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  /* Размерная линия «від заявки до монтажу» — только на десктопе, над пятью колонками */
  .process__dim {
    display: none;
  }
  @media (min-width: 64rem) {
    .process__dim {
      display: block;
      margin-bottom: 1.5rem;
      color: var(--color-oak);
    }
    .process {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--grid-gap);
    }
    .process__step {
      grid-template-columns: 1fr;
      padding-bottom: 0;
    }
    .process__step:not(:last-child)::before {
      top: 1.5rem;
      bottom: auto;
      left: 3rem;
      right: calc(-1 * var(--grid-gap));
      width: auto;
      height: 1px;
    }
    .process__body {
      padding-top: 0;
    }
    /* Под заголовок шага — две строки, чтобы описания всех пяти шагов начинались на одной линии */
    .process__title {
      min-height: calc(2 * var(--text-h4) * var(--text-h4--line-height));
    }
  }
</style>
