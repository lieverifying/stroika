---
// Блок 6 — «Своя команда» (решение владельца, 2026-10-20). Заголовок и подзаголовок — facts.teamTitle / teamSubtitle.
// Замір, дизайн-проєкт і монтаж делает своя команда, детали — фабрики-партнёры. Главный козырь: блок крупный и тёмный.
// Одно фото команды или монтажа (facts.teamPhoto) и текст: что делаем сами и что входит в монтаж (facts.services.install).
// Карточки мастеров (имена, фото, стаж) — за флагом facts.flags.teamCards, выключен до согласия мастеров.
// Видео — фасад, грузится только по клику (facts.teamVideo).
import Fact from '../ui/Fact.astro';
import PlaceholderImage from '../ui/PlaceholderImage.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import VideoFacade from '../ui/VideoFacade.astro';
import { facts } from '../../content/facts';
import { has, pluralUk, withDefault } from '../../lib/facts';

const team = facts.flags.teamCards ? facts.team : [];
// Нет факта — нет блока: фото и видео выводим, только когда владелец их прислал
const photo = has(facts.teamPhoto);
const video = has(facts.teamVideo) ? facts.teamVideo : null;
const heading = withDefault(facts.teamTitle);
const subtitle = withDefault(facts.teamSubtitle);
// 4 мастера — в ряд, 2 — по два, остальное — по три в ряд
const cols = team.length === 4 ? 4 : team.length <= 2 ? 2 : 3;
---

<section data-block="6" class="team on-dark" aria-labelledby="team-title">
  <div class="container-site">
    <SectionTitle id="team-title" title={heading.text} pendingFact={heading.pending} subtitle={subtitle.text} dark />
    <div class:list={['team__main', { 'team__main--text': !photo }]}>
      {
        photo && (
          <div class="team__photo">
            <PlaceholderImage width={1600} height={1200} label="команда або монтаж, горизонтальне 4:3" />
          </div>
        )
      }
      <div class="team__text">
        <p class="team__lead">Приїжджаємо на замір, готуємо дизайн-проєкт і встановлюємо меблі самі. Деталі за нашим проєктом виготовляють фабрики-партнери.</p>
        <div>
          <h3 class="team__subtitle">Монтаж включає</h3>
          <ul class="team__install">
            {facts.services.install.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
    {
      team.length > 0 && (
        <ul class="team__list" style={`--team-cols: ${cols}`}>
          {team.map((m, i) => (
            <li class="team__card">
              <PlaceholderImage width={1200} height={1600} label={`майстер ${i + 1}, вертикальне 3:4`} />
              <div class="team__body">
                <p class="team__name">
                  <Fact value={m.name} />
                </p>
                <p class="team__role">
                  <Fact value={m.role} /> · стаж <Fact value={m.years} /> {pluralUk(m.years, ['рік', 'роки', 'років'])}
                </p>
                <blockquote class="team__quote">
                  <Fact value={m.quote} />
                </blockquote>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    {
      video && (
        <div class="team__video">
          <VideoFacade src={String(video)} title="Команда «Вимір» на монтажі" />
        </div>
      )
    }
  </div>
</section>

<style>
  /* Крупнее соседей: больше воздуха сверху и снизу, тёмный фон */
  .team {
    margin-top: var(--space-section);
    padding-block: calc(var(--space-section) * 1.25);
    background: var(--color-graphite);
    color: var(--color-plaster);
  }
  .team__main {
    display: grid;
    gap: 1.5rem;
  }
  .team__photo :global(.ph) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: var(--color-graphite-2);
    color: var(--color-ink-muted-dark);
  }
  .team__photo :global(.ph__dim) {
    stroke: var(--color-ink-muted-dark);
  }
  .team__text {
    display: grid;
    align-content: center;
    gap: 1.5rem;
  }
  .team__lead {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    max-width: 40ch;
  }
  .team__subtitle {
    margin-bottom: 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    font-weight: 600;
  }
  .team__install {
    display: grid;
    gap: 0.5rem;
  }
  .team__install li {
    position: relative;
    padding-left: 1.5rem;
  }
  /* Отметка — короткая размерная черта, мотив замера */
  .team__install li::before {
    content: '';
    position: absolute;
    top: 0.75em;
    left: 0;
    width: 0.875rem;
    height: 1px;
    background: currentColor;
  }
  .team__list {
    margin-top: var(--space-stack);
    display: flex;
    gap: var(--grid-gap);
    margin-inline: calc(-1 * var(--space-gutter));
    padding-inline: var(--space-gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-gutter);
    scrollbar-width: none;
  }
  .team__list::-webkit-scrollbar {
    display: none;
  }
  .team__card {
    flex: 0 0 80%;
    min-width: 0;
    scroll-snap-align: start;
  }
  /* Фото мастера: 4:5 на телефоне, 3:4 на десктопе — фото, имя и роль помещаются в один экран */
  .team__card :global(.ph) {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background: var(--color-graphite-2);
    color: var(--color-ink-muted-dark);
  }
  .team__card :global(.ph__dim) {
    stroke: var(--color-ink-muted-dark);
  }
  .team__body {
    display: grid;
    gap: 0.5rem;
    padding-top: 1.25rem;
  }
  .team__name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: var(--font-display-weight);
  }
  .team__role {
    font-size: var(--text-small);
    color: var(--color-ink-muted-dark);
  }
  .team__quote {
    margin-top: 0.5rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .team__video {
    margin-top: var(--space-stack);
  }
  @media (min-width: 48rem) {
    .team__card {
      flex-basis: 45%;
    }
  }
  @media (min-width: 64rem) {
    .team__main {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3rem;
    }
    /* Без фото: текст и список монтажа в две колонки */
    .team__main--text .team__text {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3rem;
      align-items: start;
    }
    .team__list {
      display: grid;
      /* колонка не шире 24rem: при 2 мастерах фото 4:5 не растягиваются на пол-экрана */
      grid-template-columns: repeat(var(--team-cols), minmax(0, 24rem));
      gap: 2.5rem var(--grid-gap);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
    .team__card :global(.ph) {
      aspect-ratio: 3 / 4;
    }
  }
</style>
