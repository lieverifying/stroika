---
// Блок 13 — финал главной (решение владельца, 2026-10-21): крупные «Подзвонити» и «Viber» + короткая форма замера
// (ім'я, телефон, согласие). Якорь #zamir — сюда ведёт кнопка шапки без JS.
import ZamirForm from '../forms/ZamirForm.astro';
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { facts } from '../../content/facts';
import { contactLinks } from '../../lib/contacts';
---

<section id="zamir" data-block="13" class="section-pad" aria-labelledby="final-title">
  <div class="container-site final">
    <div class="final__contact">
      <SectionTitle id="final-title" title="Безкоштовний замір" subtitle="Зателефонуйте, напишіть у Viber або залиште номер — передзвонимо й домовимося про час." />
      <div class="final__buttons">
        <Button href={contactLinks.tel} variant="secondary" size="lg" icon="phone" fullWidth>Подзвонити</Button>
        <Button href={contactLinks.viber} variant="secondary" size="lg" icon="viber" fullWidth>Viber</Button>
      </div>
      <p class="final__phone"><a href={contactLinks.tel}>{facts.contacts.phoneDisplay}</a></p>
    </div>
    <div class="final__form">
      <ZamirForm compact />
    </div>
  </div>
</section>

<style>
  .final {
    display: grid;
    gap: var(--space-stack);
  }
  .final__contact {
    display: grid;
    align-content: start;
  }
  .final__buttons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .final__buttons :global(.btn) {
    min-height: 4rem;
    font-size: var(--text-lead);
  }
  .final__phone {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-lead);
  }
  .final__phone a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
  }
  .final__form {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  @media (min-width: 48rem) {
    .final__form {
      padding: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .final {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>
