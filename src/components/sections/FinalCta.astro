---
// Финал главной и посадочных (ТЗ v2): тёмный блок «Скажіть розмір — ми скажемо ціну» и кнопки Viber, Telegram, Подзвонити.
// Отдельного крупного номера под кнопками нет (правка 2026-10-22): звонок — кнопкой «Подзвонити».
// Якорь #zamir — сюда ведут старые ссылки «на замір».
import Button from '../ui/Button.astro';
import DimLine from '../ui/DimLine.astro';
import { contactLinks } from '../../lib/contacts';
---

<section id="zamir" data-block="13" class="final on-dark section-pad" aria-labelledby="final-title">
  <div class="container-site final__inner">
    <DimLine label="ваш розмір, мм" class="final__dim" />
    <h2 id="final-title" class="text-h2">Скажіть розмір — ми скажемо ціну</h2>
    <p class="final__lead">Надішліть розміри або фото приміщення — розрахунок прийде в месенджер.</p>
    <div class="final__buttons">
      <Button href={contactLinks.viber} variant="light" icon="viber" fullWidth>Viber</Button>
      <Button href={contactLinks.telegram} variant="light" icon="telegram" fullWidth>Telegram</Button>
      <Button href={contactLinks.tel} variant="outline" icon="phone" fullWidth>Подзвонити</Button>
    </div>
  </div>
</section>

<style>
  .final {
    background: var(--color-graphite);
    color: var(--color-plaster);
  }
  .final__inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .final__inner :global(.final__dim) {
    max-width: 16rem;
    color: var(--color-ink-muted-dark);
  }
  .final__lead {
    max-width: 40rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-muted-dark);
  }
  .final__buttons {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }
  @media (min-width: 48rem) {
    .final__buttons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 44rem;
    }
  }
</style>
