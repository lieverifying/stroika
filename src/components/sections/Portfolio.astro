---
// Блок 3 — «Наші роботи» (решение владельца, 2026-10-21): 6 лучших работ из src/content/portfolio.json (featured),
// ровные ряды без обрезки, фото открывается на весь экран, внизу «Усі роботи» → /roboty.
import Lightbox from '../portfolio/Lightbox.astro';
import PortfolioGrid from '../portfolio/PortfolioGrid.astro';
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { FEATURED } from '../../lib/portfolio';
---

<section data-block="3" class="section-pad" aria-labelledby="portfolio-title" data-gallery>
  <div class="container-site">
    <SectionTitle id="portfolio-title" title="Наші роботи" />
    <PortfolioGrid items={FEATURED} eager={0} fill />
    <div class="portfolio__more">
      <Button href="/roboty" variant="secondary" icon="arrow-right">Усі роботи</Button>
    </div>
  </div>
  <Lightbox />
</section>

<style>
  .portfolio__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-stack);
  }
</style>
