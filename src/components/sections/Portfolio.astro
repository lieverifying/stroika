---
// Блок 3 — «Роботи нашої команди» (ТЗ v2, название — правка 2026-10-21): работы из src/content/portfolio.json (featured.home / kukhni / mebli), карточки
// 4:5 на телефоне и 1:1 на десктопе, без подписей, фото открывается на весь экран; внизу — в галерею.
import Lightbox from '../portfolio/Lightbox.astro';
import PortfolioGrid from '../portfolio/PortfolioGrid.astro';
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import type { PortfolioItem } from '../../lib/portfolio';

interface Props {
  title: string;
  items: PortfolioItem[];
  moreHref: string;
  moreLabel: string;
  /** Колонок на телефоне и с 768 px */
  cols?: [number, number];
}
const { title, items, moreHref, moreLabel, cols = [2, 3] } = Astro.props;
---

<section data-block="3" class="section-pad" aria-labelledby="portfolio-title" data-gallery>
  <div class="container-site">
    <SectionTitle id="portfolio-title" title={title} />
    <PortfolioGrid items={items} eager={0} cols={cols} />
    <div class="portfolio__more">
      <Button href={moreHref} variant="outline" icon="arrow-right">{moreLabel}</Button>
    </div>
  </div>
  <Lightbox />
</section>

<style>
  .portfolio__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-stack);
  }
</style>
