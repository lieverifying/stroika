---
// Блок 10 — «Відгуки» (ТЗ): только реальные отзывы с согласия авторов + рейтинг Google.
// Всё — заглушки facts.reviews и facts.google; ни одного придуманного отзыва или рейтинга.
// Телефон — лента со scroll-snap, десктоп — 3 колонки. Ссылка «Всі відгуки в Google» — во внешней вкладке.
import Button from '../ui/Button.astro';
import Fact from '../ui/Fact.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { facts } from '../../content/facts';
import { pluralUk } from '../../lib/facts';

const { reviews, google } = facts;
---

<section data-block="10" class="section-pad" aria-labelledby="reviews-title">
  <div class="container-site">
    <SectionTitle id="reviews-title" title="Відгуки" />
    <p class="reviews__rating">
      Рейтинг у Google <Fact value={google.rating} class="reviews__num" /> з 5 ·
      <Fact value={google.reviewsCount} class="reviews__num" />{' '}
      {pluralUk(google.reviewsCount, ['відгук', 'відгуки', 'відгуків'])}
    </p>
    <ul class="reviews">
      {
        reviews.map((r) => (
          <li class="reviews__card">
            <blockquote class="reviews__text">
              <Fact value={r.text} />
            </blockquote>
            <p class="reviews__author">
              <Fact value={r.author} />
            </p>
            <p class="reviews__meta">
              <Fact value={r.district} /> · <Fact value={r.source} />
            </p>
          </li>
        ))
      }
    </ul>
    <div class="reviews__more">
      <Button href={google.reviewsUrl} variant="outline" icon="arrow-right" target="_blank" rel="noopener">
        Всі відгуки в Google
      </Button>
    </div>
  </div>
</section>

<style>
  .reviews__rating {
    margin-top: calc(-1 * var(--space-stack) + 0.75rem);
    margin-bottom: var(--space-stack);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .reviews__rating :global(.reviews__num) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .reviews {
    display: flex;
    gap: var(--grid-gap);
    margin-inline: calc(-1 * var(--space-gutter));
    padding-inline: var(--space-gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-gutter);
    scrollbar-width: none;
  }
  .reviews::-webkit-scrollbar {
    display: none;
  }
  .reviews__card {
    flex: 0 0 85%;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.5rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    scroll-snap-align: start;
  }
  .reviews__text {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .reviews__author {
    margin-top: 0.5rem;
    font-weight: 600;
  }
  .reviews__meta {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .reviews__more {
    display: grid;
    margin-top: var(--space-stack);
  }
  @media (min-width: 48rem) {
    .reviews__card {
      flex-basis: 45%;
    }
    .reviews__more {
      justify-content: start;
    }
  }
  @media (min-width: 64rem) {
    .reviews {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
</style>
