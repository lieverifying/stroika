---
// «Як ми створюємо» на главной (ТЗ v2): тёмный блок — кадр сюжета кухни (этап 4 из 7), точки этапов «04 / 07»,
// заголовок и ссылка на /yak-my-stvoriuiemo. Статичный: сам сюжет по прокрутке — на своей странице и посадочных.
import { getImage } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import frame from '../../assets/stories/kitchen/kitchen-04-fronts.png';
import kitchen from '../../content/stories/kitchen.json';

const STAGE = 4;
const total = kitchen.stages.length;
const stage = kitchen.stages[STAGE - 1];
const img = await getImage({ src: frame, widths: [480, 800, 1200], format: 'webp', quality: 72 });
const pad = (n: number) => String(n).padStart(2, '0');
---

<section data-block="story-teaser" class="teaser on-dark section-pad" aria-labelledby="teaser-title">
  <div class="container-site teaser__inner">
    <figure class="teaser__media">
      <img
        src={img.src}
        srcset={img.srcSet.attribute}
        sizes="(min-width: 64rem) 50vw, 90vw"
        width={frame.width}
        height={frame.height}
        alt={stage.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="teaser__caption">Візуалізація етапів</figcaption>
    </figure>
    <div class="teaser__text">
      <div class="teaser__stages" aria-label={`Етап ${STAGE} з ${total}`}>
        <span class="teaser__count">{pad(STAGE)} / {pad(total)}</span>
        <span class="teaser__dots" aria-hidden="true">
          {kitchen.stages.map((_, i) => <span class:list={['teaser__dot', { 'is-on': i + 1 === STAGE }]} />)}
        </span>
      </div>
      <h2 id="teaser-title" class="text-h2">Подивіться, як ми створюємо меблі — від порожньої стіни до готової кухні</h2>
      <a href="/yak-my-stvoriuiemo" class="teaser__link">
        Дивитися всі етапи
        <Icon name="arrow-right" size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  .teaser {
    background: var(--color-graphite);
    color: var(--color-plaster);
  }
  .teaser__inner {
    display: grid;
    gap: var(--space-stack);
    align-items: center;
  }
  .teaser__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
  }
  .teaser__caption {
    margin-top: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted-dark);
  }
  .teaser__text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .teaser__stages {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .teaser__count {
    font-family: var(--font-mono);
    font-size: var(--text-lead);
    color: var(--color-plaster);
  }
  .teaser__dots {
    display: flex;
    gap: 0.375rem;
  }
  .teaser__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-ink-muted-dark);
    opacity: 0.5;
  }
  .teaser__dot.is-on {
    background: var(--color-plaster);
    opacity: 1;
  }
  .teaser__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--control-h);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (min-width: 64rem) {
    .teaser__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
