---
// Блок «Нестандартне завдання» (решение владельца, 2026-10-20), якорь #zapyt. С 2026-10-21 — на /kontakty.
// Сюда же ведёт вариант квиза «Інше, нестандартне». Режим запуска (2026-10-21): без имени и фото владельца, без минут.
// Форма: описание 10–1000 символов, до 3 файлов (JPG, PNG, HEIC, PDF, до 10 МБ), поля контакта, согласие.
// Кнопка графитовая: жёлтый на экране остаётся за кнопками квиза и замера.
// Отправка — api/lead.php (файлы — multipart), затем /dyakuyemo; при сбое — текст ошибки и прямые кнопки связи.
import ContactFields from '../quiz/ContactFields.astro';
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Textarea from '../ui/form/Textarea.astro';
import FilesField from '../ui/form/FilesField.astro';
import '../ui/form/field.css';
---

<section id="zapyt" class="section-pad" aria-labelledby="zapyt-title" data-section="zapyt">
  <div class="container-site zapyt">
    <div class="zapyt__intro">
      <SectionTitle id="zapyt-title" title="Нестандартне завдання" />
      <p class="zapyt__lead">
        Опишіть, що потрібно зробити — ми зв’яжемося з вами особисто у робочий час і дамо детальну відповідь: терміни, орієнтовну
        вартість і наступні кроки.
      </p>
    </div>

    <form class="zapyt__form" action="/api/lead.php" method="post" enctype="multipart/form-data" novalidate data-zapyt-form>
      <input type="hidden" name="source" value="zapyt" />
      <Textarea name="request" id="zapyt-request" label="Що потрібно зробити" rows={5} required error="Опишіть завдання — щонайменше 10 символів" />
      <FilesField id="zapyt-files" label="До 3 фото або плану приміщення" />
      <ContactFields prefix="zapyt" />
      <Button type="submit" variant="secondary" size="lg" fullWidth>Надіслати запит</Button>
      <p class="zapyt__status" role="status" aria-live="polite" data-form-status></p>
    </form>
  </div>
</section>

<style>
  .zapyt {
    display: grid;
    gap: var(--space-stack);
  }
  .zapyt__intro {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .zapyt__lead {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    max-width: 52ch;
  }
  .zapyt__form {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .zapyt__status:empty {
    display: none;
  }
  .zapyt__status {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  @media (min-width: 48rem) {
    .zapyt__form {
      padding: 2rem;
    }
    }
  @media (min-width: 64rem) {
    .zapyt {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
    }
    }
</style>

<script>
  import { clearErrorsOnFix, setFieldError, validateForm } from '../../lib/lead/field-errors';
  import { saveThanks, toMethod } from '../../lib/lead/result-store';
  import { leadLanding } from '../../lib/landing';
  import { track } from '../../lib/track';
  import { showSendError } from '../../lib/lead/send-error';
  import { submitLead } from '../../lib/lead/submit';
  import { leadSucceeded } from '../../lib/tags';
  import { validateConsent, validateFiles, validateName, validatePhone, validateRequest } from '../../lib/lead/validate';
  import { normalizePhone } from '../../lib/phone';

  type Field = HTMLInputElement | HTMLTextAreaElement;
  const CHECKS = {
    request: (f: Field) => validateRequest(f.value),
    files: (f: Field) => validateFiles((f as HTMLInputElement).files ?? []),
    name: (f: Field) => validateName(f.value),
    phone: (f: Field) => validatePhone(f.value),
    consent: (f: Field) => validateConsent((f as HTMLInputElement).checked),
  };

  const form = document.querySelector<HTMLFormElement>('form[data-zapyt-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const filesInput = form.querySelector<HTMLInputElement>('input[name="files"]')!;
    clearErrorsOnFix(form, CHECKS);

    // Проверка сразу после выбора (имена файлов показывает FilesField)
    filesInput.addEventListener('change', () => setFieldError(filesInput, CHECKS.files(filesInput)));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateForm(form, CHECKS)) {
        if (status) status.textContent = '';
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      if (status) status.textContent = 'Надсилаємо…';
      const data = new FormData(form);
      const method = toMethod(data.get('method'));
      const name = String(data.get('name') ?? '').trim();
      // Способ связи — первым полем: в Telegram-сообщении он первой строкой (ARCHITECTURE.md 7)
      const landing = leadLanding();
      const res = await submitLead({
        contactMethod: method,
        form: 'zapyt',
        landing, // последняя посадочная (kukhni / mebli) или 'none'
        request: String(data.get('request') ?? '').trim(),
        name,
        phone: normalizePhone(String(data.get('phone') ?? '')),
        referrer: String(data.get('referrer') ?? '').trim(),
        consent: true,
        website: data.get('website') ?? '',
      }, { files: Array.from(filesInput.files ?? []) });
      if (res.ok) {
        track('lead_submit', { form: 'zapyt', landing });
        leadSucceeded('zapyt');
        saveThanks({ name, method, result: null });
        location.assign('/dyakuyemo');
      } else {
        if (button) button.disabled = false;
        showSendError(status);
      }
    });
  }
</script>
