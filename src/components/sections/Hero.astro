---
// Блок 1 — первый экран главной (ТЗ). Все обещания — заглушки facts.ts до подтверждения владельцем.
// Телефон: заголовок, выгоды, две кнопки — над нижней панелью; фото ниже во всю ширину, 4:3.
// Десктоп: фото справа, верх фото = верх H1; рамка по facts.media.heroOrientation (4:5 или 4:3).
// Сезонный бейдж — отдельной строкой над H1, включается facts.flags.seasonalBadge.
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Fact from '../ui/Fact.astro';
import PlaceholderImage from '../ui/PlaceholderImage.astro';
import { facts } from '../../content/facts';
import { contactLinks } from '../../lib/contacts';

const { promises, warranty, flags } = facts;
const portrait = facts.media.heroOrientation === 'portrait';
// Размер фото, которое нужно прислать: вертикальное 4:5 или горизонтальное 4:3
const photo = portrait
  ? { width: 1200, height: 1500, label: 'кухня, перший екран, вертикальне 4:5' }
  : { width: 1600, height: 1200, label: 'кухня, перший екран, горизонтальне 4:3' };
---

<section data-block="1" class="hero" aria-labelledby="hero-title">
  <div class:list={['hero__inner container-site', { 'hero__inner--portrait': portrait }]}>
    {
      flags.seasonalBadge && (
        <div class="hero__badge">
          <Badge>
            <Fact value={facts.seasonalBadgeText} />
          </Badge>
        </div>
      )
    }

    <div class="hero__text">
      <h1 id="hero-title" class="text-h1">
        Кухні на замовлення в Черкасах
        <span class="hero__tail">— <Fact value={promises.oneTeam} /></span>
      </h1>

      <ul class="hero__benefits" aria-label="Переваги">
        <li><span class="hero__num" aria-hidden="true">01</span><span>Замір і 3D за <Fact value={promises.measure3dHours} /> год</span></li>
        <li><span class="hero__num" aria-hidden="true">02</span><span><Fact value={promises.priceFixedText} /></span></li>
        <li><span class="hero__num" aria-hidden="true">03</span><span>Гарантія <Fact value={warranty.years} /> р.</span></li>
      </ul>

      <div class="hero__actions">
        <Button href="/#kvyz" size="lg" icon="calculator" ctaPriority={3}>Розрахувати вартість</Button>
        <Button href={contactLinks.viber} variant="secondary" icon="viber">
          Написати у Viber
        </Button>
      </div>
    </div>

    <div class="hero__media">
      <PlaceholderImage {...photo} />
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    gap: 2rem;
    padding-top: 1.5rem;
    /* Ниже сразу «Цифри довіри» со своей линией сверху — полный отступ блока здесь не нужен */
    padding-bottom: var(--space-stack);
  }
  /* Бейдж — своя строка сетки: на десктопе он не сдвигает H1 относительно фото */
  .hero__badge {
    margin-bottom: -1rem;
  }
  .hero__tail {
    display: block;
    margin-top: 0.25em;
    color: var(--color-ink-muted);
  }
  /* Временная плашка-заглушка в H1 не должна спорить с заголовком, но и не меньше 16 px */
  .hero__tail :global(.fact-ph) {
    font-size: 1rem;
    vertical-align: middle;
  }
  .hero__benefits {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    line-height: 1.4;
  }
  .hero__benefits li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  /* Номера выгод — моноширинный дуб: деталь «размерной» темы, без жёлтого */
  .hero__num {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-oak);
  }
  .hero__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  /* Фото на телефоне — во всю ширину экрана; до десктопа всегда 4:3, вертикальное фото обрезается */
  .hero__media {
    margin-inline: calc(-1 * var(--space-gutter));
  }
  .hero__media :global(.ph) {
    aspect-ratio: 4 / 3;
  }

  /* Планшет: фото в пределах контейнера, кнопки в ряд */
  @media (min-width: 48rem) {
    .hero__inner {
      gap: 2.5rem;
      padding-top: 2.5rem;
    }
    .hero__media {
      margin-inline: 0;
    }
    .hero__media :global(.ph) {
      border-radius: var(--radius-lg);
    }
    .hero__actions {
      grid-auto-flow: column;
      justify-content: start;
    }
  }

  /* Десктоп: текст слева, фото справа; верх фото на уровне верха H1 */
  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: start;
      column-gap: 4rem;
      padding-top: 3rem;
    }
    /* Вертикальная рамка выше: колонку фото сужаем, чтобы фото целиком помещалось в первый экран 1280 × 800 */
    .hero__inner--portrait {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .hero__badge {
      grid-column: 1;
    }
    .hero__text {
      grid-column: 1;
    }
    .hero__media {
      grid-column: 2;
    }
    .hero__badge ~ .hero__text,
    .hero__badge ~ .hero__media {
      grid-row: 2;
    }
    .hero__media :global(.ph) {
      aspect-ratio: var(--ph-ratio);
    }
    .hero__benefits {
      margin-top: 2rem;
    }
    .hero__actions {
      margin-top: 2.5rem;
    }
  }
</style>
