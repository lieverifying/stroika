---
// Блок 1 — первый экран посадочной (/kukhni, /mebli, ТЗ v2): фото, H1, одна строка, «Порахувати вартість» и «Написати у Viber».
// Тексты и фото — из пропсов страницы.
// < 1024 px: фото первым во всю ширину, 4:3 → H1 → строка → кнопки (кнопки могут уйти ниже первого экрана:
//   «Порахувати» всегда есть в нижней панели). В DOM текст идёт первым — H1 первый для скринридера.
// ≥ 1024 px: фото справа (рамка по пропорции фото: вертикальное — 4:5, горизонтальное — 4:3), текст слева по центру фото.
// Фото по умолчанию — facts.media.hero (id в src/content/portfolio.json), обрезка по focus.
// Бейдж — facts.flags.seasonalBadge.
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import type { IconName } from '../ui/Icon.astro';
import Fact from '../ui/Fact.astro';
import { facts } from '../../content/facts';
import { contactLinks } from '../../lib/contacts';
import { HERO, responsive, type PortfolioPhoto } from '../../lib/portfolio';

interface Props {
  title: string;
  lead: string;
  /** Фото первого экрана; по умолчанию — facts.media.hero (кухня) */
  photo?: PortfolioPhoto;
  /** Точка кадра при обрезке до 16:10 на телефоне */
  focus?: string;
  quizHref: string;
  /** Подпись жёлтой кнопки (на /planuvannya — «Надіслати план») */
  ctaLabel?: string;
  /** Подпись кнопки Viber */
  viberLabel?: string;
  ctaIcon?: IconName;
}
const {
  title,
  lead,
  photo = HERO,
  focus = facts.media.heroFocus,
  quizHref,
  ctaLabel = 'Порахувати вартість',
  viberLabel = 'Написати у Viber',
  ctaIcon = 'calculator',
} = Astro.props;
const { flags } = facts;
const portrait = photo.height > photo.width;

---

<section
  data-block="1"
  class="hero"
  aria-labelledby="hero-title"
  style={`--hero-focus: ${focus}`}
>
  <div class:list={['hero__inner container-site', { 'hero__inner--portrait': portrait }]}>
    <div class="hero__text">
      {
        flags.seasonalBadge && (
          <div class="hero__badge">
            <Badge>
              <Fact value={facts.seasonalBadgeText} />
            </Badge>
          </div>
        )
      }

      <h1 id="hero-title" class="text-h1">{title}</h1>

      <p class="hero__lead">{lead}</p>

      <div class="hero__actions">
        <Button href={quizHref} size="lg" icon={ctaIcon} ctaPriority={3}>{ctaLabel}</Button>
        <Button href={contactLinks.viber} variant="secondary" icon="viber">
          {viberLabel}
        </Button>
      </div>
    </div>

    <div class="hero__media">
      <img
        src={responsive(photo).src}
        srcset={responsive(photo).srcset}
        sizes="(min-width: 64rem) 40vw, 100vw"
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    gap: 1.5rem;
    padding-bottom: var(--space-stack);
  }
  /* Фото первым и во всю ширину экрана, 4:3 */
  .hero__media {
    order: -1;
    margin-inline: calc(-1 * var(--space-gutter));
  }
  .hero__media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero__media :global(.ph),
  .hero__media :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: var(--hero-focus);
  }
  .hero__badge {
    margin-bottom: 1rem;
  }
  .hero__lead {
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-muted);
  }
  .hero__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* Планшет: фото в пределах контейнера со скруглением, кнопки в ряд */
  @media (min-width: 48rem) {
    .hero__inner {
      gap: 2.5rem;
      padding-top: 2rem;
    }
    .hero__media {
      margin-inline: 0;
    }
    .hero__media :global(.ph),
    .hero__media :global(img) {
      border-radius: var(--radius-lg);
    }
    .hero__actions {
      grid-auto-flow: column;
      justify-content: start;
    }
  }

  /* Десктоп: текст слева по центру фото, фото справа под шапкой */
  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      column-gap: 4rem;
      padding-top: 3rem;
    }
    /* Вертикальная рамка выше: колонку фото сужаем, чтобы фото целиком помещалось в первый экран 1280 × 800 */
    .hero__inner--portrait {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .hero__media {
      order: 0;
    }
    .hero__media :global(.ph),
    .hero__media :global(img) {
      aspect-ratio: 4 / 3;
    }
    .hero__inner--portrait .hero__media :global(img) {
      aspect-ratio: 4 / 5;
    }
    .hero__actions {
      margin-top: 2.5rem;
    }
  }
</style>
