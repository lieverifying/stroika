---
// Квиз на посадочной (ТЗ v2). Якорь #kvyz — сюда ведут «Порахувати вартість» и кнопка панели.
// Один вопрос на экран. На посадочной шаг 1 пропущен: preset — ветка страницы (кухня или шафа).
import Quiz from '../quiz/Quiz.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import type { Goal } from '../../lib/quiz/types';

interface Props {
  title: string;
  preset?: Extract<Goal, 'kitchen' | 'wardrobe'>;
}
const { title, preset } = Astro.props;
---

<section id="kvyz" data-block="5" class="section-pad" aria-labelledby="quiz-title">
  <div class="container-site quiz-section">
    <SectionTitle
      id="quiz-title"
      title={title}
      subtitle="Оберіть, що вам потрібно, — ми порахуємо і надішлемо ціну у зручний для вас месенджер"
    />
    <Quiz preset={preset} />
  </div>
</section>

<style>
  .quiz-section {
    max-width: calc(56rem + 2 * var(--space-gutter));
  }
</style>
