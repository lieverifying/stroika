---
// Блок 5 — квиз (ТЗ). Якорь #kvyz — сюда ведут «Розрахувати вартість» и кнопка панели.
import Quiz from '../quiz/Quiz.astro';
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="kvyz" data-block="5" class="section-pad" aria-labelledby="quiz-title">
  <div class="container-site quiz-section">
    <SectionTitle id="quiz-title" title="Дізнайтесь вартість вашої кухні за 1 хвилину" />
    <Quiz />
  </div>
</section>

<style>
  .quiz-section {
    max-width: calc(56rem + 2 * var(--space-gutter));
  }
</style>
