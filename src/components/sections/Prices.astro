---
// Блок 8 — «Скільки коштує» (решение владельца, 2026-10-21): цен и сроков на сайте нет — их считаем под задачу
// клиента после заміру и надсилаємо в месенджер. Блок объясняет, от чего зависит ціна, и ведёт в квиз (одна жёлтая кнопка).
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';

interface Props {
  /** Куда ведёт кнопка: на «Меблі» — сразу в ветку шафы квиза */
  quizHref?: string;
}
const { quizHref = '/kukhni#kvyz' } = Astro.props;

const factors = [
  { title: 'Розміри', text: 'Довжина, висота, глибина і форма.' },
  { title: 'Матеріали', text: 'Фасади, корпуси і стільниця.' },
  { title: 'Наповнення', text: 'Фурнітура, шухляди, підсвітка, вбудована техніка.' },
];
---

<section data-block="8" class="section-pad" aria-labelledby="prices-title">
  <div class="container-site">
    <SectionTitle
      id="prices-title"
      title="Скільки коштує"
      subtitle="Ціну й терміни розрахуємо під ваше завдання після безкоштовного заміру і надішлемо у зручний месенджер."
    />
    <ul class="prices">
      {
        factors.map((f, i) => (
          <li class="prices__card">
            <span class="prices__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="prices__name">{f.title}</h3>
            <p class="prices__text">{f.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="prices__cta">
      <Button href={quizHref} size="lg" icon="calculator" ctaPriority={3}>Розрахувати вартість</Button>
    </div>
  </div>
</section>

<style>
  .prices {
    display: grid;
    gap: 0.75rem;
  }
  .prices__card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.25rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
  }
  .prices__num {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-oak);
  }
  .prices__name {
    font-family: var(--font-body);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    font-weight: 600;
  }
  .prices__text {
    color: var(--color-ink-muted);
  }
  .prices__cta {
    display: grid;
    margin-top: var(--space-stack);
  }
  @media (min-width: 48rem) {
    .prices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap);
    }
    .prices__card {
      padding: 1.5rem;
    }
    .prices__cta {
      justify-content: start;
    }
  }
</style>
