---
// Посадочная (решение владельца, 2026-10-21): /kukhni и /mebli по одной структуре, тексты у каждой свои.
// 1 фото, H1 и одна строка → сюжет сборки (визуализация этапов, «Детальніше») → 3 «Наші роботи» (6 фото, lightbox)
// → 5 квиз (ветка выбрана заранее, виден только текущий шаг) → 12 вопросы → 13 «Подзвонити», «Viber» и короткая форма.
// Шапка с переключателем «Кухні · Меблі» и подвал — в BaseLayout.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Portfolio from '../sections/Portfolio.astro';
import QuizSection from '../sections/QuizSection.astro';
import Faq from '../sections/Faq.astro';
import FinalCta from '../sections/FinalCta.astro';
import Story, { type StoryData } from '../story/Story.astro';
import type { FaqItem } from '../../content/faq';
import { quizHref, type Landing } from '../../lib/landing';
import type { PortfolioItem, PortfolioPhoto } from '../../lib/portfolio';

interface Props {
  landing: Landing;
  title: string;
  description: string;
  h1: string;
  lead: string;
  heroPhoto?: PortfolioPhoto;
  heroFocus?: string;
  story: StoryData;
  storyHeading: string;
  worksTitle: string;
  works: PortfolioItem[];
  worksMoreHref: string;
  worksMoreLabel: string;
  quizTitle: string;
  quizSubtitle: string;
  faq: FaqItem[];
  finalSubtitle: string;
}
const p = Astro.props;
const preset = p.landing === 'mebli' ? 'wardrobe' : 'kitchen';
---

<BaseLayout title={p.title} description={p.description}>
  <Hero title={p.h1} lead={p.lead} photo={p.heroPhoto} focus={p.heroFocus} quizHref={quizHref(p.landing)} />
  <div class="container-site section-pad">
    <Story story={p.story} heading={p.storyHeading} moreHref="/yak-my-stvoriuiemo" />
  </div>
  <Portfolio title={p.worksTitle} items={p.works} moreHref={p.worksMoreHref} moreLabel={p.worksMoreLabel} />
  <QuizSection title={p.quizTitle} subtitle={p.quizSubtitle} preset={preset} />
  <Faq items={p.faq} />
  <FinalCta subtitle={p.finalSubtitle} source={`${p.landing}-final`} />
</BaseLayout>
