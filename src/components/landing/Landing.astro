---
// Посадочная (ТЗ v2, 2026-10-21): /kukhni и /mebli по одной структуре, тексты у каждой свои.
// Порядок (правка 2026-10-22, квиз выше): 1 фото, H1, строка, «Порахувати вартість» и «Написати у Viber»
// → 2 квиз (шаг выбора пропущен: /kukhni — с формы кухни, /mebli — с типа шафы) → 3 «Роботи нашої команди»
// → 4 три обіцянки → 5 сюжет сборки (візуалізація етапів) → 6 питання і відповіді → 7 финал.
// Шапка с переключателем «Кухні · Меблі» и подвал — в BaseLayout.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Portfolio from '../sections/Portfolio.astro';
import QuizSection from '../sections/QuizSection.astro';
import Promises from '../sections/Promises.astro';
import Faq from '../sections/Faq.astro';
import FinalCta from '../sections/FinalCta.astro';
import Story, { type StoryData } from '../story/Story.astro';
import { FAQ } from '../../content/faq';
import { quizHref, type Landing } from '../../lib/landing';
import { HERO, responsive, type PortfolioItem, type PortfolioPhoto } from '../../lib/portfolio';

interface Props {
  landing: Landing;
  title: string;
  description: string;
  h1: string;
  lead: string;
  heroPhoto?: PortfolioPhoto;
  heroFocus?: string;
  story: StoryData;
  storyHeading: string;
  worksTitle: string;
  works: PortfolioItem[];
  worksCols?: [number, number];
  worksMoreHref: string;
  worksMoreLabel: string;
  quizTitle: string;
}
const p = Astro.props;
const HERO_SIZES = '(min-width: 64rem) 40vw, 100vw';
---

<BaseLayout title={p.title} description={p.description} compactH2 lcpImage={{ srcset: responsive(p.heroPhoto ?? HERO).srcset, sizes: HERO_SIZES }}>
  <Hero title={p.h1} lead={p.lead} photo={p.heroPhoto} focus={p.heroFocus} quizHref={quizHref(p.landing)} />
  <QuizSection title={p.quizTitle} preset={p.landing === 'mebli' ? 'wardrobe' : 'kitchen'} />
  <Portfolio title={p.worksTitle} items={p.works} cols={p.worksCols} moreHref={p.worksMoreHref} moreLabel={p.worksMoreLabel} />
  <Promises variant="scroll" />
  <div class="container-site section-pad">
    <Story story={p.story} heading={p.storyHeading} moreHref="/yak-my-stvoriuiemo" />
  </div>
  <Faq items={FAQ} />
  <FinalCta />
</BaseLayout>
