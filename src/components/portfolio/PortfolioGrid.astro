---
// Сетка работ (ТЗ v2): карточки одной пропорции — 4:5 на телефоне, 1:1 с 768 px; обрезка по полю focus из portfolio.json,
// чтобы мебель оставалась в кадре. cols — колонок на телефоне и с 768 px. wide — горизонтальные фото (шире 6:5)
// занимают две колонки, чтобы не терять мебель по бокам (галерея /roboty).
// Фото — кнопка, открывает просмотр на весь экран (Lightbox.astro). Видео — muted, playsinline, loop, controls,
// preload="none"; запускается без звука, только когда видно на экране (скрипт portfolio.ts).
// Первые eager превью грузятся сразу, остальные — loading="lazy".
import { url, type PortfolioItem } from '../../lib/portfolio';

interface Props {
  items: PortfolioItem[];
  eager?: number;
  cols?: [number, number];
  wide?: boolean;
  class?: string;
}
const { items, eager = 4, cols = [2, 3], wide = false, class: className } = Astro.props;
const isWide = (i: PortfolioItem) => wide && i.width / i.height > 1.2;
---

<ul class:list={['pf', className]} style={`--cols-m: ${cols[0]}; --cols-d: ${cols[1]}`} data-pf-grid>
  {
    items.map((item, i) => (
      <li
        class:list={['pf__item', { 'pf__item--wide': isWide(item) }]}
        data-category={item.category}
        data-id={item.id}
        style={`--focus: ${item.focus ?? '50% 50%'}`}
      >
        {item.type === 'photo' ? (
          <button
            type="button"
            class="pf__open"
            data-full={url(item.src)}
            data-w={item.width}
            data-h={item.height}
            aria-label={`Відкрити на весь екран: ${item.alt}`}
          >
            <img
              src={url(item.thumb)}
              width={item.width}
              height={item.height}
              alt={item.alt}
              loading={i < eager ? undefined : 'lazy'}
              decoding="async"
            />
          </button>
        ) : (
          <video
            class="pf__video"
            src={url(item.src)}
            poster={url(item.poster)}
            width={item.width}
            height={item.height}
            muted
            playsinline
            loop
            controls
            preload="none"
            aria-label={item.alt}
            data-pf-video
          />
        )}
      </li>
    ))
  }
</ul>

<style>
  .pf {
    display: grid;
    grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: 0.5rem;
  }
  .pf__item {
    aspect-ratio: 4 / 5;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-white);
  }
  /* Горизонтальное фото на две колонки той же высоты, что и соседи в ряду */
  .pf__item--wide {
    grid-column: span 2;
    aspect-ratio: 8 / 5;
  }
  .pf__item[hidden] {
    display: none;
  }
  .pf__open {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .pf__open:focus-visible {
    outline: 2px solid var(--color-graphite);
    outline-offset: -2px;
  }
  .pf__open img,
  .pf__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transition: transform 0.4s var(--ease-out);
  }
  .pf__video {
    background: var(--color-graphite);
  }
  @media (hover: hover) {
    .pf__open:hover img {
      transform: scale(1.03);
    }
  }
  @media (min-width: 48rem) {
    .pf {
      grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr));
      gap: 0.75rem;
    }
    .pf__item {
      aspect-ratio: 1;
    }
    .pf__item--wide {
      aspect-ratio: 2;
    }
  }
</style>
