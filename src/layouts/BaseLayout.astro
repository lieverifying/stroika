---
// Общий шаблон страницы: lang="uk", шрифты, SEO, шапка, футер и нижняя панель.
// bare — без шапки, подвала и нижней панели. На посадочных (/kukhni, /mebli)
// body получает data-landing — по нему заявка помечается страницей-источником (src/lib/landing.ts).
import '../styles/global.css';
import Fonts from '../components/layout/Fonts.astro';
import SeoHead from '../components/layout/SeoHead.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import MobileBottomBar from '../components/layout/MobileBottomBar.astro';
import Footer from '../components/layout/Footer.astro';
import { landingOfPath, pagePath } from '../lib/landing';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  bare?: boolean;
}

const { title, description, noindex, bare = false } = Astro.props;
const landing = landingOfPath(pagePath(Astro.url));
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <!-- Масштабирование не запрещаем (CLAUDE.md) -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead title={title} description={description} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F1F1EE" />
    <Fonts />
  </head>
  <body data-landing={landing ?? undefined} class:list={{ 'is-bare': bare }}>
    <SkipLink />
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <MobileBottomBar />}
    <script>
      import { initCtaArbiter } from '../lib/cta-arbiter';
      import { captureAttribution } from '../lib/lead/attribution';
      initCtaArbiter();
      captureAttribution(new URL(location.href), document.referrer);
    </script>
  </body>
</html>
