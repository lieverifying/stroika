---
// Общий шаблон страницы: lang="uk", шрифты, SEO, шапка, футер и нижняя панель.
// bare — без шапки, подвала и нижней панели. На посадочных (/kukhni, /mebli)
// body получает data-landing — по нему заявка помечается страницей-источником (src/lib/landing.ts).
import '../styles/global.css';
import Fonts from '../components/layout/Fonts.astro';
import SeoHead from '../components/layout/SeoHead.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import MobileBottomBar from '../components/layout/MobileBottomBar.astro';
import Footer from '../components/layout/Footer.astro';
import Analytics from '../components/layout/Analytics.astro';
import { landingOfPath, pagePath } from '../lib/landing';
import { localBusiness } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  bare?: boolean;
  /** Фото первого экрана (LCP): предзагрузка в <head>, чтобы браузер начал качать его до разбора CSS */
  lcpImage?: { srcset: string; sizes: string };
  /** H2 мельче (главная и посадочные, правки 2026-10-21): −15 % на телефоне, −25 % на десктопе */
  compactH2?: boolean;
  /** Open Graph-картинка из public/og/ */
  ogImage?: string;
  /** Дополнительные схемы JSON-LD; LocalBusiness добавляется на всех индексируемых страницах */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, bare = false, lcpImage, compactH2 = false, ogImage, jsonLd = [] } = Astro.props;
const schemas = noindex ? jsonLd : [localBusiness(Astro.site), ...jsonLd];
const landing = landingOfPath(pagePath(Astro.url));
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <!-- Масштабирование не запрещаем (CLAUDE.md) -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead title={title} description={description} noindex={noindex} ogImage={ogImage} jsonLd={schemas} />
    <Analytics />
    <!-- Иконки: SVG — Chrome и Firefox; ICO и PNG — Safari во вкладках; apple-touch-icon — iOS (scripts/favicons.mjs) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F1F1EE" />
    <Fonts />
    {lcpImage && <link rel="preload" as="image" imagesrcset={lcpImage.srcset} imagesizes={lcpImage.sizes} fetchpriority="high" />}
  </head>
  <body data-landing={landing ?? undefined} class:list={{ 'is-bare': bare, 'h2-compact': compactH2 }}>
    <SkipLink />
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <MobileBottomBar />}
    <script>
      import { initCtaArbiter } from '../lib/cta-arbiter';
      import { captureAttribution } from '../lib/lead/attribution';
      initCtaArbiter();
      captureAttribution(new URL(location.href), document.referrer);
    </script>
  </body>
</html>
