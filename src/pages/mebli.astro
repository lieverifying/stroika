---
// /mebli — посадочная для шаф, гардеробних і інших меблів (ТЗ v2, 2026-10-21): фото shafa-01, сюжет — шафа-купе,
// работы — шафи, гардеробна, ТВ-зона. Структура та же, что у /kukhni (src/components/landing/Landing.astro).
import Landing from '../components/landing/Landing.astro';
