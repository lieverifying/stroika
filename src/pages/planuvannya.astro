---
// /planuvannya — лендинг под рекламу Meta: лид-магнит «Два варіанти планування» кухни (решение владельца, 2026-10-22).
// Структура и правила — src/components/plan/PlanLanding.astro. «Переглянути сайт» ведёт на главную.
import PlanLanding from '../components/plan/PlanLanding.astro';
import { facts } from '../content/facts';
import { FEATURED, photoById } from '../lib/portfolio';

const h = facts.leadMagnet.planHours;
---

<PlanLanding
  variant="kitchen"
  title="Два варіанти планування кухні безкоштовно — Вимір"
  description={`Надішліть фото або план кухні з розмірами — дизайнер підготує два варіанти розташування протягом ${h} годин у робочі дні.`}
  h1="Два варіанти планування вашої кухні — безкоштовно"
  lead={`Надішліть фото або план приміщення з розмірами — дизайнер підготує два варіанти розташування протягом ${h} годин у робочі дні і надішле розрахунок у Viber або Telegram.`}
  photo={photoById('kukhnia-05')}
  ctaLabel="Надіслати план"
  steps={[
    'Надсилаєте фото або план',
    `Дизайнер готує 2 варіанти до ${h} годин у робочі дні`,
    'Отримуєте розрахунок у месенджер',
    'Безкоштовний замір і точна ціна в договорі',
  ]}
  formTitle="Надішліть план або фото"
  formSubtitle="Розміри можна вказати приблизно — уточнимо в месенджері."
  zamirTitle="Немає плану чи фото? Замовте безкоштовний замір"
  works={FEATURED.kukhni}
  faq={[
    { q: 'Це справді безкоштовно?', a: 'Так. Два варіанти планування і розрахунок — безкоштовно.' },
    {
      q: 'Що, якщо в мене немає плану?',
      a: 'Надішліть фото кухні та приблизні розміри — цього достатньо. Або ',
      zamirLink: { text: 'замовте безкоштовний замір', after: ' — приїдемо і все заміряємо самі.' },
    },
    { q: 'Чи зобов’язує це мене замовляти?', a: 'Ні.' },
  ]}
  finalTitle="Два варіанти планування — безкоштовно"
  siteHref="/"
/>
