---
// /planuvannya-mebli — лендинг под рекламу Meta: лид-магнит «Два варіанти наповнення» шафы (решение владельца, 2026-10-22).
// Та же структура и правила, что /planuvannya (src/components/plan/PlanLanding.astro): без меню, noindex, Pixel, UTM,
// запасная форма заміру. «Переглянути сайт» ведёт на /mebli.
// Работы: все фото мебели архива — shafa-01…03, garderobna-01, tv-zona-01 (других нет, поэтому 5). Сетка в 2 колонки:
// горизонтальные шафи и ТВ-зона — на всю ширину ряда, шафа-03 и гардеробна — парой; одиночных карточек нет.
import PlanLanding from '../components/plan/PlanLanding.astro';
import { facts } from '../content/facts';
import { photoById } from '../lib/portfolio';

const h = facts.leadMagnet.planHours;
const works = ['shafa-01', 'shafa-03', 'garderobna-01', 'shafa-02', 'tv-zona-01'].map(photoById);
---

<PlanLanding
  variant="mebli"
  title="Два варіанти наповнення шафи безкоштовно — Вимір"
  description={`Надішліть фото ніші або кімнати з розмірами — дизайнер запропонує два варіанти наповнення шафи протягом ${h} годин у робочі дні.`}
  h1="Два варіанти наповнення вашої шафи — безкоштовно"
  lead={`Надішліть фото ніші або кімнати з розмірами — дизайнер запропонує два варіанти полиць, штанг і шухляд протягом ${h} годин у робочі дні та надішле розрахунок у Viber або Telegram.`}
  photo={photoById('shafa-01')}
  focus="50% 55%"
  ctaLabel="Надіслати розміри"
  steps={[
    'Надсилаєте фото і розміри ніші',
    `Дизайнер готує 2 варіанти наповнення до ${h} годин у робочі дні`,
    'Отримуєте розрахунок у месенджер',
    'Безкоштовний замір і точна ціна в договорі',
  ]}
  formTitle="Надішліть фото і розміри"
  formSubtitle="Розміри можна вказати приблизно — уточнимо в месенджері."
  zamirTitle="Немає розмірів? Замовте безкоштовний замір"
  works={works}
  worksWide
  worksWideIds={['tv-zona-01']}
  worksCols={[2, 2]}
  faq={[
    { q: 'Це справді безкоштовно?', a: 'Так. Два варіанти наповнення і розрахунок — безкоштовно.' },
    {
      q: 'Що, якщо я не знаю точних розмірів?',
      a: 'Надішліть фото і приблизні розміри — або ',
      zamirLink: { text: 'замовте безкоштовний замір', after: '.' },
    },
    { q: 'Чи зобов’язує це мене замовляти?', a: 'Ні.' },
  ]}
  finalTitle="Два варіанти наповнення — безкоштовно"
  siteHref="/mebli"
/>
