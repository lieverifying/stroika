---
// /dyakuyemo — страница после заявки (минимальная, фаза 4; полная — фаза 5). noindex всегда.
// Формы кладут имя, способ связи и результат квиза в sessionStorage (result-store.ts); без них — общий текст.
import BaseLayout from '../layouts/BaseLayout.astro';
import QuizResult from '../components/quiz/QuizResult.astro';
import Button from '../components/ui/Button.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import { contactLinks } from '../lib/contacts';
---

<BaseLayout title="Дякуємо — Вимір" description="Заявку прийнято." noindex>
  <section class="container-site thanks section-pad">
    <h1 class="text-h1">Заявку прийнято</h1>
    <QuizResult />
    <div class="thanks__actions">
      <Button href={contactLinks.tel} variant="secondary" icon="phone">Подзвонити</Button>
      <Button href={contactLinks.viber} variant="secondary" icon="viber">Написати у Viber</Button>
      <Button href="/" variant="outline">На головну</Button>
    </div>
    <div class="thanks__actions" aria-label="Соцмережі">
      <SocialLinks />
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    display: grid;
    gap: var(--space-stack);
    max-width: calc(48rem + 2 * var(--space-gutter));
  }
  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
