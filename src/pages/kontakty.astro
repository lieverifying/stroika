---
// /kontakty (ТЗ v2, 2026-10-21): крупные кнопки телефона, Viber, Telegram, Instagram, TikTok; «Черкаси та область»;
// форма «Нестандартне завдання» (#zapyt) — сюда ведёт вариант квиза «Інше, нестандартне».
// Ссылки — src/lib/contacts.ts (единый источник). Режим запуска: строки без фактов скрыты.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import PlaceholderImage from '../components/ui/PlaceholderImage.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import CustomRequest from '../components/sections/CustomRequest.astro';
import { facts } from '../content/facts';
import { contactLinks } from '../lib/contacts';
import { has } from '../lib/facts';

const { contacts: c, serviceArea, flags } = facts;
// Нет факта — нет строки: график, почта, адрес, условия выезда и карта — только когда есть данные
const rows = [
  ...(flags.schedule && has(c.scheduleText) ? [{ label: 'Графік', text: c.scheduleText }] : []),
  ...(has(c.emailPublic) ? [{ label: 'Пошта', text: c.emailPublic, href: contactLinks.email }] : []),
  ...(flags.address && has(c.address) ? [{ label: 'Адреса', text: c.address }] : []),
];
---

<BaseLayout title="Контакти — Вимір, кухні та меблі на замовлення в Черкасах" description="Телефон, Viber, Telegram, Instagram і TikTok «Вимір». Замір і монтаж — Черкаси та область.">
  <div class="container-site section-pad contacts">
    <h1 class="text-h1">Контакти</h1>

    <section class="contacts__card" aria-labelledby="contacts-call">
      <h2 id="contacts-call" class="contacts__title">Зателефонуйте або напишіть</h2>
      <a href={contactLinks.tel} class="contacts__phone">
        <Icon name="phone" size={28} />
        {c.phoneDisplay}
      </a>
      <div class="contacts__buttons">
        <Button href={contactLinks.tel} variant="secondary" icon="phone" fullWidth>Подзвонити</Button>
        <Button href={contactLinks.viber} variant="secondary" icon="viber" fullWidth>Viber</Button>
        <Button href={contactLinks.telegram} variant="secondary" icon="telegram" fullWidth>Telegram</Button>
        <SocialLinks variant="secondary" />
      </div>
      {
        rows.length > 0 && (
          <dl class="contacts__list">
            {rows.map((r) => (
              <div>
                <dt>{r.label}</dt>
                <dd>{r.href ? <a href={r.href}>{r.text}</a> : r.text}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="contacts__area">
        <p class="contacts__area-label">Зона виїзду</p>
        <p class="contacts__area-text">{serviceArea.text}</p>
        {has(serviceArea.terms) && <p class="contacts__muted">{serviceArea.terms}</p>}
        {
          flags.serviceAreaMap && (
            <div class="contacts__map">
              <PlaceholderImage width={1200} height={900} label="карта зони виїзду" />
            </div>
          )
        }
      </div>
    </section>
  </div>
  <CustomRequest />
</BaseLayout>

<style>
  .contacts {
    display: grid;
    gap: var(--space-stack);
    padding-bottom: 0;
  }
  .contacts__card {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .contacts__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: var(--font-display-weight);
  }
  .contacts__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--control-h);
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    font-weight: 500;
  }
  /* Крупные кнопки: на телефоне по одной в строку, с 768 px — сеткой */
  .contacts__buttons {
    display: grid;
    gap: 0.75rem;
  }
  .contacts__buttons :global(.btn) {
    width: 100%;
  }
  .contacts__list {
    display: grid;
    gap: 0.75rem;
  }
  .contacts__list dt,
  .contacts__area-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-oak);
  }
  .contacts__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contacts__area {
    display: grid;
    gap: 0.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .contacts__area-text {
    font-size: var(--text-lead);
    font-weight: 600;
  }
  .contacts__muted {
    color: var(--color-ink-muted);
  }
  .contacts__map :global(.ph) {
    border-radius: var(--radius-md);
  }
  @media (min-width: 48rem) {
    .contacts__card {
      padding: 2.5rem;
    }
    .contacts__buttons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
