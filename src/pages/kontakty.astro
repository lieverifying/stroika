---
// /kontakty (ТЗ): телефон, месенджери, графік, зона виїзду (Черкаси та область) з картою, коротка форма,
// «Нестандартне завдання» (#zapyt) — перенесено с главной 2026-10-21, сюда ведёт вариант квиза «Інше, нестандартне».
// Ссылки — src/lib/contacts.ts (единый источник). Режим запуска: строки без фактов скрыты.
import BaseLayout from '../layouts/BaseLayout.astro';
import ZamirForm from '../components/forms/ZamirForm.astro';
import Button from '../components/ui/Button.astro';
import Fact from '../components/ui/Fact.astro';
import Icon from '../components/ui/Icon.astro';
import PlaceholderImage from '../components/ui/PlaceholderImage.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { facts } from '../content/facts';
import { contactLinks } from '../lib/contacts';
import { has } from '../lib/facts';
import CustomRequest from '../components/sections/CustomRequest.astro';

const { contacts: c, serviceArea, flags } = facts;
// Нет факта — нет строки: график, почта, адрес, Instagram, условия выезда и карта — только когда есть данные
const rows = [
  ...(flags.schedule && has(c.scheduleText) ? [{ label: 'Графік', text: c.scheduleText }] : []),
  ...(has(c.emailPublic) ? [{ label: 'Пошта', text: c.emailPublic, href: contactLinks.email }] : []),
  ...(flags.address && has(c.address) ? [{ label: 'Адреса', text: c.address }] : []),
];
---

<BaseLayout title="Контакти — Вимір, кухні та меблі на замовлення в Черкасах" description="Телефон, Viber, Telegram і графік роботи «Вимір». Замір і монтаж — Черкаси та область.">
  <div class="container-site section-pad contacts">
    <h1 class="text-h1">Контакти</h1>

    <div class="contacts__grid">
      <section class="contacts__card" aria-labelledby="contacts-call">
        <h2 id="contacts-call" class="contacts__title">Зателефонуйте або напишіть</h2>
        <a href={contactLinks.tel} class="contacts__phone">
          <Icon name="phone" size={24} />
          <Fact value={c.phoneDisplay} />
        </a>
        <div class="contacts__messengers">
          <Button href={contactLinks.viber} variant="secondary" icon="viber">Viber</Button>
          <Button href={contactLinks.telegram} variant="secondary" icon="telegram">Telegram</Button>
          {
            flags.instagram && contactLinks.instagram && (
              <Button href={contactLinks.instagram} variant="outline" icon="instagram" target="_blank" rel="noopener">
                Instagram
              </Button>
            )
          }
        </div>
        {
          rows.length > 0 && (
            <dl class="contacts__list">
              {rows.map((r) => (
                <div>
                  <dt>{r.label}</dt>
                  <dd>{r.href ? <a href={r.href}>{r.text}</a> : r.text}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </section>

      <section class="contacts__card" aria-labelledby="contacts-area">
        <h2 id="contacts-area" class="contacts__title">Зона виїзду</h2>
        <p class="contacts__area">{serviceArea.text}</p>
        {has(serviceArea.terms) && <p class="contacts__muted">{serviceArea.terms}</p>}
        {
          flags.serviceAreaMap && (
            <div class="contacts__map">
              <PlaceholderImage width={1200} height={900} label="карта зони виїзду" />
            </div>
          )
        }
      </section>
    </div>

    <section id="zamir" class="contacts__form" aria-labelledby="contacts-form-title">
      <SectionTitle id="contacts-form-title" title="Безкоштовний замір" subtitle="Залиште номер — передзвонимо й домовимося про час." />
      <ZamirForm idPrefix="kontakty" source="kontakty" />
    </section>
  </div>
  <CustomRequest />
</BaseLayout>

<style>
  .contacts {
    display: grid;
    gap: var(--space-stack);
  }
  .contacts__grid {
    display: grid;
    gap: var(--grid-gap);
  }
  .contacts__card {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .contacts__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: var(--font-display-weight);
  }
  .contacts__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--control-h);
    font-family: var(--font-mono);
    font-size: var(--text-lead);
    font-weight: 500;
  }
  .contacts__messengers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .contacts__list {
    display: grid;
    gap: 0.75rem;
  }
  .contacts__list dt {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .contacts__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contacts__area {
    font-size: var(--text-lead);
    font-weight: 600;
  }
  .contacts__muted {
    color: var(--color-ink-muted);
  }
  .contacts__map :global(.ph) {
    border-radius: var(--radius-md);
  }
  .contacts__form {
    display: grid;
    gap: 0;
    max-width: 40rem;
  }
  @media (min-width: 48rem) {
    .contacts__card {
      padding: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .contacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
