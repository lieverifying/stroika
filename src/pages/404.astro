---
// 404 (ТЗ): «Сторінку не знайдено» + кнопки на главную и в квиз. Всегда noindex.
// На хостинге отдаётся через ErrorDocument в public/.htaccess.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Сторінку не знайдено — Вимір" description="Такої сторінки немає." noindex>
  <section class="container-site section-pad notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1 class="text-h1">Сторінку не знайдено</h1>
    <p class="notfound__text">Можливо, посилання застаріло. Почніть з головної або одразу розрахуйте вартість.</p>
    <div class="notfound__actions">
      <Button href="/#kvyz" size="lg" icon="calculator" ctaPriority={3}>Розрахувати вартість</Button>
      <Button href="/" variant="outline" size="lg">На головну</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-number);
    line-height: 1;
    color: var(--color-oak);
  }
  .notfound__text {
    max-width: 40ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .notfound__actions {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin-top: 1rem;
  }
  @media (min-width: 48rem) {
    .notfound__actions {
      grid-auto-flow: column;
      justify-content: start;
      width: auto;
    }
  }
</style>
