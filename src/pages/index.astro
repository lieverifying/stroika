---
// Временная страница фазы 2: каркас заменяется по мере задач 2.5–2.9
import '../styles/global.css';
import Fonts from '../components/layout/Fonts.astro';
import Fact from '../components/ui/Fact.astro';
import { facts } from '../content/facts';
import { formatUAH } from '../lib/facts';

const sample = 'Ґанок, їжак, єнот, ІІ — 1234 грн';
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Вимір — кухні та меблі на замовлення, Черкаси</title>
    <Fonts />
  </head>
  <body>
    <main class="container-site py-(--space-section)">
      <h1 class="text-h1">{facts.brand.name}</h1>
      <p class="text-lead mt-4 text-ink-muted">{facts.brand.descriptor}</p>

      <section class="mt-12 space-y-6" aria-label="Перевірка шрифтів">
        <p class="font-display text-h3">{sample}</p>
        <p class="text-body">{sample} <span class="font-semibold">({sample})</span></p>
        <p class="font-mono text-price">{sample}</p>
      </section>

      <section class="mt-12 space-y-3" aria-label="Перевірка фактів">
        <p>Гарантія: <Fact value={facts.warranty.years} /> років</p>
        <p>Число (демо форматування): <Fact value={45000} format={formatUAH} class="font-mono" /></p>
        <p>Рядок: <Fact value={facts.brand.descriptor} /></p>
      </section>
    </main>
  </body>
</html>
