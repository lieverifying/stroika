---
// «/» — главная бренда (ТЗ v2, 2026-10-21): кто мы, три обіцянки, вход в «Кухні» и «Шафи та меблі».
// 1 первый экран → 2 три обіцянки → 3 две двери → 4 «Як ми створюємо» (тёмный блок) → 5 роботи (6 фото разных категорий)
// → 6 «Без колл-центру» → 7 финал. Шапка, подвал и нижняя панель — в BaseLayout.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import Promises from '../components/sections/Promises.astro';
import Doors from '../components/sections/Doors.astro';
import StoryTeaser from '../components/sections/StoryTeaser.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import NoCallCenter from '../components/sections/NoCallCenter.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { quizHref } from '../lib/landing';
import { FEATURED, photoById, responsive } from '../lib/portfolio';
---

<BaseLayout
  title="Вимір — кухні та корпусні меблі під ваш розмір у Черкасах"
  description="Меблі, які точно підходять: кухні, шафи та гардеробні на замовлення. Замір, дизайн-проєкт і монтаж — Черкаси та область."
  lcpImage={{ srcset: responsive(photoById('kukhnia-05')).srcset, sizes: '(min-width: 64rem) 45vw, 90vw' }}
>
  <HomeHero quizHref={quizHref(null)} />
  <Promises />
  <Doors />
  <StoryTeaser />
  <Portfolio title="Наші роботи" items={FEATURED.home} moreHref="/roboty" moreLabel="Усі роботи" />
  <NoCallCenter />
  <FinalCta />
</BaseLayout>
