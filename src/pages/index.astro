---
// Главная (решение владельца, 2026-10-21): короче и визуальнее, без пустых блоков.
// 1 первый экран → сюжет кухни (как на «Як ми створюємо») → 3 «Наші роботи» → 5 квиз → 12 «Питання і відповіді» → 13 финал.
// Шапка (0) и подвал (14) — в BaseLayout. «Нестандартне завдання» — на /kontakty.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import QuizSection from '../components/sections/QuizSection.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Story, { type StoryData } from '../components/story/Story.astro';
import kitchen from '../content/stories/kitchen.json';
---

<BaseLayout
  title="Кухні на замовлення в Черкасах — Вимір"
  description="Кухні та корпусні меблі на замовлення: Черкаси та область. Безкоштовний замір і розрахунок вартості."
>
  <Hero />
  <div class="container-site section-pad">
    <Story story={kitchen as StoryData} heading="Як ми створюємо кухню" moreHref="/yak-my-stvoriuiemo" />
  </div>
  <Portfolio />
  <QuizSection />
  <Faq />
  <FinalCta />
</BaseLayout>
