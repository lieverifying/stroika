# Хостинг adm.tools (Apache). Страница 404 и постоянные перенаправления (CLAUDE.md, «Страницы»).
ErrorDocument 404 /404.html

# Сборка кладёт страницы файлами (build.format = 'file': kukhni.html), а ссылки на сайте — без расширения (/kukhni).
# Отдаём /kukhni из kukhni.html; адрес с .html перенаправляем на адрес без расширения.
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Ремонт убран с сайта (2026-10-20)
Redirect 301 /remont /

# Сжатие текстовых ответов (на мобильном интернете страница приходит в 3–4 раза меньше)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Кэш: файлы сборки с хешем в имени (/_astro/) не меняются — год; фото работ — 30 дней; страницы — всегда проверять
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(portfolio|brand)/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
</IfModule>
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
